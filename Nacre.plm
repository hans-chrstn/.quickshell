language 0.9

import "scenes/common/Theme.plm"
import "scenes/common/GlassBody.plm"
import "scenes/common/Primitives.plm"
import "scenes/island/DynamicIslandBody.plm"
import "scenes/island/CompactView.plm"
import "scenes/island/ExpandedView.plm"
import "scenes/island/SearchView.plm"
import "scenes/utility/SideUtilityView.plm"
import "scenes/utility/AudioStudioCard.plm"
import "scenes/utility/UtilityDrumRail.plm"

scene Nacre {
    permissions {
        run: "hyprctl"
        services: "clock", "media", "media.*", "apps", "apps.launch", "audio", "audio.*"
    }

    service clock as now {
        time: text = "--:--"
        date: text = ""
    }

    service media as song {
        playing: bool = false
        title: text = ""
        artist: text = ""
        album: text = ""
        length: number = 0
        position: number = 0
        rate: number = 1.0
        can_seek: bool = false
        player: text = ""
    }

    service audio as sound {
        volume: number = 0.0
        muted: bool = false
        input: number = 0.0
        input_muted: bool = false
    }

    include "scenes/state/island.plm"
    include "scenes/state/utility.plm"
    include "scenes/surfaces/island.plm"
    include "scenes/surfaces/utility.plm"
}
