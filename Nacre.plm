language 0.9

import "scenes/common/Theme.plm"
import "scenes/common/components/glass.plm"
import "scenes/common/components/wave.plm"
import "scenes/common/components/controls.plm"
import "scenes/common/components/search.plm"
import "scenes/common/components/glyphs.plm"
import "scenes/common/components/control-components.plm"
import "scenes/common/components/edge-intent.plm"
import "scenes/island/IslandBody.plm"
import "scenes/utility/ControlBody.plm"

scene Nacre {
    permissions {
        run: "curl", "ls", "pactl", "grim", "satty", "wf-recorder", "xdg-user-dir", "mkdir"
        services: "clock", "apps", "apps.launch", "media", "media.toggle", "media.previous", "media.next", "media.seek", "env", "notifications", "notification_history", "notifications.clear", "notifications.clear_history", "audio", "audio.level", "brightness", "files", "files.write", "window", "window.restore", "window.minimize", "window.activate", "window.close"
    }

    service clock as now {
        hour: number = 0
        minute: number = 0
        second: number = 0
        day: number = 0
        month: number = 0
        year: number = 0
        weekday: number = 0
        time: text = "--:--"
        date: text = ""
    }

    include "scenes/state/theme.plm"
    include "scenes/state/island.plm"
    include "scenes/state/control.plm"
    include "scenes/state/osd.plm"
    include "scenes/surfaces/island.plm"
    include "scenes/surfaces/control.plm"
    include "scenes/surfaces/osd.plm"
}
