                at: cx, cy
                size: 9, 9
                corner: 4.5
                color: col
            }
            box {
                at: cx, cy - 7.6
                size: 1.7, 3.4
                corner: 0.8
                color: col
            }
            box {
                at: cx, cy + 7.6
                size: 1.7, 3.4
                corner: 0.8
                color: col
            }
            box {
                at: cx - 7.6, cy
                size: 3.4, 1.7
                corner: 0.8
                color: col
            }
            box {
                at: cx + 7.6, cy
                size: 3.4, 1.7
                corner: 0.8
                color: col
            }
            box {
                at: cx - 5.3, cy - 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx + 5.3, cy - 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx - 5.3, cy + 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx + 5.3, cy + 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
        }

        group {
            show: kind == 2

            box {
                at: cx - 3.9, cy - 3.6
                size: 6.2, 6.2
                corner: 3.1
                color: col
            }
            box {
                at: cx - 3.9, cy - 9.5
                size: 1.5, 2.8
                corner: 0.8
                color: col
            }
            box {
                at: cx - 10.1, cy - 3.6
                size: 2.8, 1.5
                corner: 0.8
                color: col
            }
            box {
                at: cx - 8.1, cy - 8.1
                size: 2.1, 2.1
                corner: 1
                color: col
            }
            ellipse {
                at: cx - 1.7, cy + 1.7
                radius: 3.4
                color: col
            }
            ellipse {
                at: cx + 1.7, cy
                radius: 4.2
                color: col
            }
            ellipse {
