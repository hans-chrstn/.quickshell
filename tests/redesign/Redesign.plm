                at: cx - 4.5, cy + 4.5
                size: 1.7, 4.2
                corner: 0.8
                color: col
            }
            box {
                at: cx, cy + 6.2
                size: 1.7, 4.2
                corner: 0.8
                color: col
            }
            box {
                at: cx + 4.5, cy + 4.5
