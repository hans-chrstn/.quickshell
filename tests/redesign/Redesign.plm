                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
                size: 11.9, 3.6
                corner: 1.8
                color: col
            }
            ellipse {
                at: cx - 4.5, cy + 5
                radius: 1.5
                color: col
            }
            ellipse {
                at: cx, cy + 6.7
                radius: 1.5
                color: col
            }
            ellipse {
                at: cx + 4.5, cy + 5
                radius: 1.5
                color: col
            }
        }

        group {
            show: kind == 8

            ellipse {
                at: cx - 2.5, cy - 2
                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
