            }
            box {
                at: cx + 1.7, cy + 3.4
                size: 14, 3.9
                corner: 2
                color: col
            }
        }

        group {
            show: kind == 3

            ellipse {
                at: cx - 3.4, cy
                radius: 3.9
                color: col
            }
            ellipse {
                at: cx + 0.3, cy - 2
                radius: 4.8
                color: col
            }
            ellipse {
                at: cx + 4.5, cy
                radius: 3.6
                color: col
            }
            box {
                at: cx + 0.3, cy + 3.1
                size: 15.4, 4.5
                corner: 2.2
                color: col
            }
        }

        group {
            show: kind == 4

            box {
                at: cx, cy - 4.2
                size: 15.4, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx - 0.8, cy - 0.6
                size: 11.2, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx + 0.8, cy + 3.1
                size: 14, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx - 0.6, cy + 6.7
                size: 8.4, 2.2
                corner: 1.1
                color: col
            }
        }

        group {
            show: kind == 5

            ellipse {
                at: cx - 2.5, cy - 2
