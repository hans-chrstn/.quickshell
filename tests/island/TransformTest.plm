language 0.9

import "Theme.plm"
import "DynamicIslandBody.plm"
import "CompactView.plm"
import "ExpandedView.plm"
import "SearchView.plm"

scene TransformTest {
    surface {
        size: 1920, 320
        anchor: top
        level: overlay
        screens: "DP-1"
        keyboard: on_demand
    }

    permissions {
        services: "clock", "media", "media.*", "apps", "apps.launch"
    }

    service clock as now {
        time: text = "--:--"
        date: text = ""
    }

    service media as song {
        playing: bool = false
        title: text = ""
        artist: text = ""
        album: text = ""
        length: number = 0
        position: number = 0
        rate: number = 1.0
        can_seek: bool = false
        player: text = ""
    }

    fact phase = 0
    fact playing = false
    fact media_progress = 0
    fact sel = 0

    text track_title = ""
    text track_artist = ""
    text time_elapsed = ""
    text time_remaining = ""
    text island_date = ""
    text query = ""

    model hits max 5 {
        name: text
        icon: image 20, 20
        exec: text
    }

    event open_wide ->
    event fold_compact ->
    event dismiss ->
    event media_toggle ->
    event media_prev ->
    event media_next ->
    event media_seek ->
    event launch ->
    event pop_search ->
    event search_closed ->
    event select_hit

    prop cur_y = 10 ~fluid
    prop cur_w = 140 ~fluid
    prop cur_h = 24 ~fluid
    prop cur_corner = 12 ~fluid
    prop island_alpha = 0 ~fluid
    prop shadow_alpha = 0 ~calm

    prop wave_1 = 0
    prop wave_2 = 0
    prop wave_3 = 0
    prop wave_4 = 0

    wave wave_1 = 3.5 at 3.2
    wave wave_2 = 5.0 at 4.1
    wave wave_3 = 4.2 at 2.8
    wave wave_4 = 2.8 at 3.9

    follow cur_y = if(phase == 3, search_y, if(phase == 2, expanded_y, if(phase == 1, compact_y, dormant_y)))
    follow cur_w = if(phase == 3, search_w, if(phase == 2, expanded_w, if(phase == 1, compact_w, dormant_w)))
    follow cur_h = if(phase == 3, search_h, if(phase == 2, expanded_h, if(phase == 1, compact_h, dormant_h)))
    follow cur_corner = if(phase == 3, search_corner, if(phase == 2, expanded_corner, if(phase == 1, compact_corner, dormant_corner)))
    follow shadow_alpha = if(phase == 3, search_shadow_alpha, if(phase == 2, expanded_shadow_alpha, if(phase == 1, compact_shadow_alpha, 0.0)))
    follow island_alpha = if(phase > 0, 1.0, 0.0)

    let compact_alpha = if(phase == 1 and cur_h < 60, clamp((cur_h - 25) / 11, 0, 1) * clamp(1 - (cur_h - 38) / 18, 0, 1), 0)
    let expanded_alpha = if(phase == 2 and cur_h > 85, clamp((cur_h - 85) / 35, 0, 1), 0)
    let search_alpha = if(phase == 3 and cur_h > 120, clamp((cur_h - 120) / 60, 0, 1), 0)

    let cx = 960

    group {
        opacity: island_alpha

        DynamicIslandBody(
            cx,
            cur_y,
            cur_w,
            cur_h,
            cur_corner,
            shadow_alpha,
            glass_base_color
        )

        group {
            clip box {
                at: cx, cur_y
                size: cur_w, cur_h
                corner: cur_corner
            }

            CompactView(
                cx,
                cur_y,
                now.time,
                island_date,
                wave_1,
                wave_2,
                wave_3,
                wave_4,
                compact_alpha,
                ink_primary,
                accent_primary
            )

            ExpandedView(
                cx,
                cur_y,
                track_title,
                track_artist,
                time_elapsed,
                time_remaining,
                media_progress,
                wave_1,
                wave_2,
                wave_3,
                wave_4,
                expanded_alpha,
                playing,
                ink_primary,
                ink_secondary,
                ink_muted,
                accent_primary
            )

            group {
                opacity: search_alpha

                ellipse {
                    at: cx - 176, cur_y - 86
                    radius: 5
                    stroke: 2
                    color: accent_primary
                }
                line {
                    from: cx - 172, cur_y - 82
                    to: cx - 168, cur_y - 78
                    width: 2
                    color: accent_primary
                }

                input query {
                    at: cx - 152, cur_y - 96
                    width: search_input_w
                    size: text_size_search_input
                    family: "SF Pro"
                    weight: weight_medium
                    color: ink_primary
                    placeholder: "Search applications..."
                    selection: accent_primary
                }

                box {
                    at: cx + 174, cur_y - 86
                    size: search_esc_badge_w, search_esc_badge_h
                    corner: search_esc_badge_corner
                    color: badge_bg
                }
                text "ESC" {
                    at: cx + 174, cur_y - 86
                    anchor: center
                    family: "SF Mono"
                    size: text_size_badge
                    weight: weight_semibold
                    color: ink_muted
                }

                box {
                    at: cx, cur_y - 68
                    size: search_divider_w, search_divider_h
                    color: track_bg
                }

                column results {
                    at: cx - 192, cur_y - 54
                    gap: 4
                    for h in hits {
                        AppRow(h, sel, launch, select_hit)
                    }
                }

                text "No applications found" {
                    at: cx, cur_y - 10
                    anchor: center
                    family: "SF Pro"
                    size: text_size_body
                    color: ink_muted
                    show: hits.count == 0
                }
            }
        }
    }

    zone box grace_area {
        at: cx, if(phase == 3, search_grace_y, grace_zone_y)
        size: if(phase == 3, search_grace_w, grace_zone_w), if(phase == 3, search_grace_h, grace_zone_h)
        corner: grace_zone_corner
        active: phase > 0
    }

    zone box wake_strip {
        at: cx, wake_zone_y
        size: wake_zone_w, wake_zone_h
        corner: 5
        cursor: pointer
        active: phase == 0
        label: "Wake Island"
        role: button
    }

    zone box compact_btn {
        at: cx, cur_y
        size: cur_w, cur_h
        corner: compact_corner
        cursor: pointer
        active: phase == 1
        label: "Open Island"
        role: button
    }

    zone box compact_search_btn {
        at: cx - 88, cur_y
        size: compact_badge_size + 10, compact_badge_size + 10
        corner: compact_badge_corner
        cursor: pointer
        active: phase == 1
        label: "Search Applications"
        role: button
    }

    zone box expanded_card {
        at: cx, cur_y
        size: cur_w, cur_h
        corner: expanded_corner
        cursor: pointer
        active: phase == 2
        label: "Fold Island"
        role: button
    }

    zone box scrub_track {
        at: cx, cur_y + 16
        size: scrubber_track_w, scrub_hit_h
        corner: scrub_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Scrub Media"
        role: slider
    }

    zone box prev_btn {
        at: cx - 52, cur_y + 46
        size: nav_btn_hit_size, nav_btn_hit_size
        corner: nav_btn_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Previous Track"
        role: button
    }

    zone ellipse play_btn {
        at: cx, cur_y + 46
        radius: play_btn_hit_r
        cursor: pointer
        active: phase == 2
        label: "Play or Pause"
        role: button
    }

    zone box next_btn {
        at: cx + 52, cur_y + 46
        size: nav_btn_hit_size, nav_btn_hit_size
        corner: nav_btn_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Next Track"
        role: button
    }

    zone box esc_btn {
        at: cx + 174, cur_y - 86
        size: 36, 22
        corner: 4
        cursor: pointer
        active: phase == 3
        label: "Close Search"
        role: button
    }

    on enter wake_strip { phase = 1 }
    on press wake_strip { phase = 1 }
    on press compact_btn while phase == 1 and cur_h > 30 { phase = 2; emit open_wide }
    on press right compact_btn while phase == 1 { phase = 3; focus query; emit pop_search }
    on press compact_search_btn while phase == 1 { phase = 3; focus query; emit pop_search }
    on pop_search while phase == 1 { phase = 3; focus query }
    on key Ctrl+Space while phase == 1 { phase = 3; focus query; emit pop_search }
    on key Super+Space while phase == 1 { phase = 3; focus query; emit pop_search }
    on press play_btn { emit media_toggle }
    on press prev_btn { emit media_prev }
    on press next_btn { emit media_next }
    on press scrub_track { emit media_seek(clamp((pointer.x - (cx - 142)) / 284, 0, 1)) }
    on drag scrub_track  { emit media_seek(clamp((pointer.x - (cx - 142)) / 284, 0, 1)) }
    on press expanded_card while phase == 2 { phase = 1; emit fold_compact }
    on press esc_btn while phase == 3 { phase = 1; blur; emit search_closed }
    on key Escape while phase == 3 { phase = 1; blur; emit search_closed }
    on blur while phase == 3 { phase = 1; blur; emit search_closed }
    on key Down while phase == 3 { sel = min(sel + 1, max(hits.count - 1, 0)) }
    on key Up while phase == 3 { sel = max(sel - 1, 0) }
    on select_hit(i) while phase == 3 { sel = i }
    on leave grace_area while phase == 1 { phase = 0 }
    on submit query while phase == 3 { emit launch(sel) }
}
