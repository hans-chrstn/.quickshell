language 0.9

import "../../scenes/common/Theme.plm"
import "../../scenes/island/DynamicIslandBody.plm"
import "../../scenes/island/SearchView.plm"

scene SearchTest {
    surface {
        size: 1920, 320
        anchor: top
        level: overlay
        screens: "DP-1"
        keyboard: on_demand
    }

    permissions {
        services: "apps", "apps.launch"
    }

    fact sel = 0
    fact phase = 3
    text query = ""

    model hits max 5 {
        name: text
        icon: image 20, 20
        exec: text
    }

    event launch ->
    event select_hit

    let cx = 960
    let cy = search_y
    let cw = search_w
    let ch = search_h
    let corner = search_corner

    group {
        DynamicIslandBody(
            cx,
            cy,
            cw,
            ch,
            corner,
            search_shadow_alpha,
            glass_base_color
        )

        group {
            clip box {
                at: cx, cy
                size: cw, ch
                corner: corner
            }

            ellipse {
                at: cx - 176, cy - 86
                radius: 5
                stroke: 2
                color: accent_primary
            }
            line {
                from: cx - 172, cy - 82
                to: cx - 168, cy - 78
                width: 2
                color: accent_primary
            }

            input query {
                at: cx - 152, cy - 96
                width: search_input_w
                size: text_size_search_input
                family: "SF Pro"
                weight: weight_medium
                color: ink_primary
                placeholder: "Search applications..."
                selection: accent_primary
            }

            box {
                at: cx + 174, cy - 86
                size: search_esc_badge_w, search_esc_badge_h
                corner: search_esc_badge_corner
                color: badge_bg
            }
            text "ESC" {
                at: cx + 174, cy - 86
                anchor: center
                family: "SF Mono"
                size: text_size_badge
                weight: weight_semibold
                color: ink_muted
            }

            box {
                at: cx, cy - 68
                size: search_divider_w, search_divider_h
                color: track_bg
            }

            column results {
                at: cx - 192, cy - 54
                gap: 4
                for h in hits {
                    AppRow(h, sel, launch, select_hit)
                }
            }

            text "No applications found" {
                at: cx, cy - 10
                anchor: center
                family: "SF Pro"
                size: text_size_body
                color: ink_muted
                show: hits.count == 0
            }
        }
    }

    zone box esc_btn {
        at: cx + 174, cy - 86
        size: 36, 22
        corner: 4
        cursor: pointer
        label: "Clear Search"
        role: button
    }

    on key Down { sel = min(sel + 1, max(hits.count - 1, 0)) }
    on key Up { sel = max(sel - 1, 0) }
    on select_hit(i) { sel = i }
    on press esc_btn { query = ""; focus query }
    on submit query { emit launch(sel) }
}
