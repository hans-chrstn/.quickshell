import "Theme.plm"

library CompactViewLib {
    component CompactView(
        cx: number,
        cy: number,
        time_str: text,
        date_str: text,
        w1: number,
        w2: number,
        w3: number,
        w4: number,
        opacity_val: number,
        ink: color = ink_primary,
        accent: color = accent_primary
    ) {
        group {
            opacity: opacity_val

            box {
                at: cx - 88, cy
                size: compact_badge_size, compact_badge_size
                corner: compact_badge_corner
                color: badge_bg
            }

            ellipse {
                at: cx - 88, cy
                radius: compact_jewel_outer_r
                color: accent
            }
            ellipse {
                at: cx - 88, cy
                radius: compact_jewel_inner_r
                color: ink_white
            }

            text time_str {
                at: cx - 72, cy
                anchor: left center
                family: "SF Compact"
                size: text_size_body
                weight: weight_semibold
                color: ink
            }

            text date_str {
                at: cx + 38, cy
                anchor: right center
                family: "SF Compact"
                size: text_size_caption
                weight: weight_medium
                color: ink_secondary
            }

            box {
                at: cx + 56, cy
                size: compact_eq_bar_w, compact_eq_h1 + w1
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 64, cy
                size: compact_eq_bar_w, compact_eq_h2 + w2
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 72, cy
                size: compact_eq_bar_w, compact_eq_h3 + w3
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 80, cy
                size: compact_eq_bar_w, compact_eq_h4 + w4
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 88, cy
                size: compact_eq_bar_w, compact_eq_h5 + w1
                corner: compact_eq_bar_corner
                color: accent
            }
        }
    }
}
