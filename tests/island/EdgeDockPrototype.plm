language 0.4

scene EdgeDockPrototype {
    surface { size: full, full; anchor: top_left; screens: each }

    fact edge: top | right | bottom | left = top
    fact along = 0.5
    fact moving = false
    fact moved = false
    fact dragX = 0
    fact dragY = 0

    let homeX = if(edge == left, 14, if(edge == right, screen.width - 14, clamp(along * screen.width, 24, screen.width - 24)))
    let homeY = if(edge == top, 14, if(edge == bottom, screen.height - 14, clamp(along * screen.height, 24, screen.height - 24)))
    prop orbX = screen.width / 2 ~120ms
    prop orbY = 14 ~120ms
    follow orbX = if(moving, dragX, homeX)
    follow orbY = if(moving, dragY, homeY)

    body {
        color: #070708
        rim: 5%
        ellipse { at: orbX, orbY; radius: 24 }
    }
    box { at: orbX - 7, orbY - 2; size: 6, 10; corner: 3; color: #f4f2ef }
    box { at: orbX + 7, orbY - 2; size: 6, 10; corner: 3; color: #f4f2ef }
    box { at: orbX, orbY + 10; size: 10, 2; corner: 1; color: #d9ae79 }
    zone ellipse face_grab { at: orbX, orbY; radius: 30; cursor: if(moving, grabbing, grab); label: "Move Nacre face" }

    on press face_grab { moved = false; dragX = orbX; dragY = orbY }
    on drag face_grab while drag.dx * drag.dx + drag.dy * drag.dy > 100 {
        moving = true
        moved = true
        dragX = clamp(pointer.x, 24, screen.width - 24)
        dragY = clamp(pointer.y, 24, screen.height - 24)
    }
    on release face_grab while moved {
        edge = if(pointer.y <= pointer.x and pointer.y <= screen.width - pointer.x and pointer.y <= screen.height - pointer.y, top,
               if(screen.width - pointer.x <= pointer.x and screen.width - pointer.x <= screen.height - pointer.y, right,
               if(screen.height - pointer.y <= pointer.x, bottom, left)))
        along = if(edge == top or edge == bottom, clamp(pointer.x / screen.width, 0.03, 0.97), clamp(pointer.y / screen.height, 0.03, 0.97))
        moving = false
    }
}
