import "Theme.plm"

library DynamicIslandBodyLib {
    component DynamicIslandBody(
        cx: number,
        cy: number,
        w: number,
        h: number,
        corner: number,
        shadow_alpha: number,
        base_color: color = glass_base_color
    ) {
        body {
            color: base_color
            glass: 100%
            frost: auto
            smoke: glass_smoke
            refraction: glass_refraction
            dispersion: glass_dispersion
            mirror: glass_mirror
            highlight: glass_highlight
            shadow: 0, 4, 10, shadow_alpha * shadow_base_opacity

            box {
                at: cx, cy
                size: w, h
                corner: corner
            }
        }
    }
}
