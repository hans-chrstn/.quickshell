import "../island/Theme.plm"

library SideUtilityLib {
    component ToolBead(
        cx: number,
        cy: number,
        idx: number,
        selected_idx: number,
        tool_evt: event
    ) {
        let is_sel = selected_idx == idx
        let bead_size = 32

        box hit {
            at: cx, cy
            size: bead_size, bead_size
            corner: bead_size / 2
            color: if(is_sel, accent_primary, badge_bg)
            opacity: if(is_sel, 1.0, 0.4)
            cursor: pointer
        }

        box {
            at: cx - 17, cy
            size: 2, 12
            corner: 1
            color: accent_primary
            opacity: if(is_sel, 1.0, 0.0)
        }

        on press hit { emit tool_evt(idx) }
    }

    component WallpaperCard(
        title_text: text,
        type_text: text,
        fps_text: text,
        is_active: bool,
        card_w: number,
        card_h: number,
        pick_evt: event,
        card_idx: number
    ) {
        size: card_w, card_h

        box card_hit {
            from: 0, 0
            size: card_w, card_h
            corner: util_card_corner
            color: if(is_active, accent_primary, badge_bg)
            opacity: if(is_active, 18%, 80%)
            cursor: pointer
        }

        box {
            from: 0, 12
            size: 3, card_h - 24
            corner: 1.5
            color: accent_primary
            opacity: if(is_active, 1.0, 0.0)
        }

        text title_text {
            at: 16, 22
            anchor: left center
            family: "SF Pro"
            size: text_size_body
            weight: weight_semibold
            color: if(is_active, ink_primary, ink_secondary)
        }

        text type_text {
            at: 16, 42
            anchor: left center
            family: "SF Mono"
            size: text_size_badge
            weight: weight_medium
            color: accent_primary
        }

        text fps_text {
            at: card_w - 16, 42
            anchor: right center
            family: "SF Mono"
            size: text_size_badge
            weight: weight_semibold
            color: ink_muted
        }

        on press card_hit { emit pick_evt(card_idx) }
    }
}
