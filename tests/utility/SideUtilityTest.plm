language 0.9

import "../island/Theme.plm"
import "../island/DynamicIslandBody.plm"
import "SideUtilityView.plm"

scene SideUtilityTest {
    surface {
        size: 380, 520
        anchor: right
        level: overlay
        screens: "DP-1"
        keyboard: on_demand
    }

    fact phase = 0
    fact active_tool = 0
    fact selected_wall = 0

    text wall_0_title = "Cyber Tokyo"
    text wall_0_type = "60 FPS · WEBM LOOP"
    text wall_0_res = "1920x1080"

    text wall_1_title = "Deep Sea Aurora"
    text wall_1_type = "VULKAN · WGSL SHADER"
    text wall_1_res = "PROCEDURAL"

    text wall_2_title = "Carina Nebula 8K"
    text wall_2_type = "STATIC · AVIF IMAGE"
    text wall_2_res = "3840x2160"

    event select_tool
    event pick_wall ->
    event close_flyout ->

    prop pill_alpha = 0 ~fluid
    prop flyout_alpha = 0 ~fluid
    prop flyout_x_slide = 24 ~fluid

    follow pill_alpha = if(phase > 0, 1.0, 0.0)
    follow flyout_alpha = if(phase == 2, 1.0, 0.0)
    follow flyout_x_slide = if(phase == 2, 0.0, 24.0)

    let py = 260
    let pill_cx = 380 - 12 - util_pill_w / 2
    let flyout_cx = pill_cx - util_pill_w / 2 - 12 - util_flyout_w / 2

    zone box grace_area {
        at: 190, py
        size: 380, 480
        active: phase > 0
    }

    zone box edge_wake {
        at: 377, py
        size: 6, util_pill_h + 40
        cursor: pointer
        active: phase == 0
        label: "Wake Side Island"
        role: button
    }

    group {
        group {
            opacity: flyout_alpha

            DynamicIslandBody(
                flyout_cx - flyout_x_slide,
                py,
                util_flyout_w,
                util_flyout_h,
                util_flyout_corner,
                1.0,
                glass_base_color
            )

            group {
                clip box {
                    at: flyout_cx - flyout_x_slide, py
                    size: util_flyout_w, util_flyout_h
                    corner: util_flyout_corner
                }

                text "WALLPAPERS" {
                    at: flyout_cx - flyout_x_slide - 110, py - 136
                    anchor: left center
                    family: "SF Pro"
                    size: text_size_caption
                    weight: weight_bold
                    color: ink_muted
                }

                box {
                    at: flyout_cx - flyout_x_slide + 104, py - 136
                    size: 28, 16
                    corner: 4
                    color: badge_bg
                }
                text "ESC" {
                    at: flyout_cx - flyout_x_slide + 104, py - 136
                    anchor: center
                    family: "SF Mono"
                    size: text_size_badge
                    weight: weight_semibold
                    color: ink_muted
                }

                box {
                    at: flyout_cx - flyout_x_slide, py - 118
                    size: 248, 1
                    color: track_bg
                }

                column cards {
                    at: flyout_cx - flyout_x_slide - 124, py - 104
                    gap: 8

                    WallpaperCard(
                        wall_0_title,
                        wall_0_type,
                        wall_0_res,
                        selected_wall == 0,
                        util_card_w,
                        util_card_h,
                        pick_wall,
                        0
                    )

                    WallpaperCard(
                        wall_1_title,
                        wall_1_type,
                        wall_1_res,
                        selected_wall == 1,
                        util_card_w,
                        util_card_h,
                        pick_wall,
                        1
                    )

                    WallpaperCard(
                        wall_2_title,
                        wall_2_type,
                        wall_2_res,
                        selected_wall == 2,
                        util_card_w,
                        util_card_h,
                        pick_wall,
                        2
                    )
                }

                box {
                    at: flyout_cx - flyout_x_slide, py + 144
                    size: 248, 1
                    color: track_bg
                }
                text "ENGINE: GPU VULKAN DIRECT" {
                    at: flyout_cx - flyout_x_slide, py + 154
                    anchor: center
                    family: "SF Mono"
                    size: text_size_badge
                    weight: weight_semibold
                    color: accent_primary
                }
            }
        }

        group {
            opacity: pill_alpha

            DynamicIslandBody(
                pill_cx,
                py,
                util_pill_w,
                util_pill_h,
                util_pill_corner,
                compact_shadow_alpha,
                glass_base_color
            )

            group {
                clip box {
                    at: pill_cx, py
                    size: util_pill_w, util_pill_h
                    corner: util_pill_corner
                }

                group {
                    ToolBead(pill_cx, py - 66, 0, active_tool, select_tool)
                    ellipse { at: pill_cx - 4, py - 70; radius: 2.5; color: accent_primary }
                    ellipse { at: pill_cx + 4, py - 70; radius: 2.5; color: accent_emerald }
                    ellipse { at: pill_cx - 4, py - 62; radius: 2.5; color: accent_rose }
                    ellipse { at: pill_cx + 4, py - 62; radius: 2.5; color: accent_amber }
                }

                group {
                    ToolBead(pill_cx, py - 22, 1, active_tool, select_tool)
                    box { at: pill_cx - 5, py - 22; size: 4, 6; corner: 1; color: ink_primary }
                    path { at: pill_cx - 1, py - 22; color: ink_primary; move -2, -3; line 4, -5; line 4, 5; line -2, 3; close }
                    ellipse { at: pill_cx + 7, py - 22; radius: 3; stroke: 1.5; color: ink_secondary }
                }

                group {
                    ToolBead(pill_cx, py + 22, 2, active_tool, select_tool)
                    box { at: pill_cx, py + 20; size: 14, 10; corner: 2; stroke: 1.5; color: ink_primary }
                    line { from: pill_cx, py + 26; to: pill_cx, py + 29; width: 1.5; color: ink_primary }
                    box { at: pill_cx, py + 29; size: 8, 1.5; color: ink_primary }
                }

                group {
                    ToolBead(pill_cx, py + 66, 3, active_tool, select_tool)
                    ellipse { at: pill_cx, py + 66; radius: 5; stroke: 1.5; color: ink_primary }
                    box { at: pill_cx, py + 66; size: 14, 2; color: ink_secondary }
                    box { at: pill_cx, py + 66; size: 2, 14; color: ink_secondary }
                }
            }
        }
    }

    zone box flyout_esc {
        at: flyout_cx - flyout_x_slide + 104, py - 136
        size: 32, 20
        cursor: pointer
        active: phase == 2
        label: "Close Flyout"
        role: button
    }

    on enter edge_wake { phase = 1 }
    on press edge_wake { phase = 1 }
    on select_tool(i) {
        active_tool = i
        phase = if(i == 0, 2, 1)
    }
    on press flyout_esc while phase == 2 { phase = 1 }
    on key Escape while phase == 2 { phase = 1 }
    on leave grace_area while phase == 1 { phase = 0 }
    on key Down while phase == 2 { selected_wall = min(selected_wall + 1, 2) }
    on key Up while phase == 2 { selected_wall = max(selected_wall - 1, 0) }
}
