language 0.9

import "../../scenes/common/Theme.plm"

scene WallpaperTest {
    surface wallpaper {
        size: full, full
        anchor: top_left
        level: background
        screens: "DP-1"
        keyboard: none
        rate: 60, 15 while calm
    }

    permissions {
        run: "ls"
        services: "clock"
    }

    shader hygge_bg = file "../../shaders/hygge_flow.wgsl"

    fact wall_mode = 0
    fact active_slot = 0
    fact wall_count = 0
    fact current_idx = 0

    prop crossfade = 0.0 ~calm
    follow crossfade = if(active_slot == 1, 1.0, 0.0)

    text wall_a = "/home/jin/.wallpapers/0.jpg"
    text wall_b = "/home/jin/.wallpapers/1.png"
    text current_title = "0.jpg"
    text mode_label = "STATIC CROSSFADE"

    image img_a = from wall_a, 0, 0
    image img_b = from wall_b, 0, 0

    event next_wallpaper ->
    event prev_wallpaper ->
    event toggle_mode ->
    event desk_click ->

    group {
        show: wall_mode == 0

        image img_a {
            at: 0, 0
            size: screen.width, screen.height
            fit: cover
            opacity: 1.0 - crossfade
        }

        image img_b {
            at: 0, 0
            size: screen.width, screen.height
            fit: cover
            opacity: crossfade
        }
    }

    group {
        show: wall_mode == 1

        shader hygge_bg {
            at: 0, 0
            size: screen.width, screen.height
            colors: hygge_base, hygge_terracotta
        }
    }

    zone box desk {
        at: 0, 0
        size: screen.width, screen.height
        cursor: default
    }

    on press right desk {
        emit desk_click
    }

    on desk_click {
        emit next_wallpaper
    }

    group {
        at: 40, screen.height - 80

        box {
            at: 0, 0
            size: 280, 48
            corner: 12
            color: hygge_base
            opacity: 0.85
        }

        box {
            at: 0, 0
            size: 280, 48
            corner: 12
            stroke: 1.0
            color: hygge_clay
            opacity: 0.5
        }

        text current_title {
            at: 16, 16
            size: 13
            weight: 600
            color: hygge_linen
        }

        text mode_label {
            at: 16, 32
            size: 10
            weight: 500
            color: hygge_honey
        }
    }
}
