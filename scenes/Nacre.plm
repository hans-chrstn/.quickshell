language 0.9

import "island/Theme.plm"
import "island/DynamicIslandBody.plm"
import "island/CompactView.plm"
import "island/ExpandedView.plm"

scene Nacre {
    surface {
        size: full, 260
        anchor: top
        level: overlay
        screens: each
        keyboard: on_demand
    }

    permissions {
        services: "clock", "media", "media.*"
    }

    service clock as now {
        time: text = "--:--"
        date: text = ""
    }

    service media as song {
        playing: bool = false
        title: text = ""
        artist: text = ""
        album: text = ""
        length: number = 0
        position: number = 0
        rate: number = 1.0
        can_seek: bool = false
        player: text = ""
    }

    // ── Logic State Boundary ──────────────────────────────────────
    // phase: 0 = dormant (invisible), 1 = compact island, 2 = expanded card
    fact phase = 0
    fact playing = false
    fact media_progress = 0

    text track_title = ""
    text track_artist = ""
    text time_elapsed = ""
    text time_remaining = ""
    text island_date = ""

    event open_wide ->
    event fold_compact ->
    event dismiss ->
    event media_toggle ->
    event media_prev ->
    event media_next ->
    event media_seek ->

    // ── Motion Springs & Dimensions ───────────────────────────────
    prop cur_y = 10 ~fluid
    prop cur_w = 140 ~fluid
    prop cur_h = 24 ~fluid
    prop cur_corner = 12 ~fluid
    prop island_alpha = 0 ~fluid
    prop shadow_alpha = 0 ~calm

    // Soundwave visualizer bars
    prop wave_1 = 0
    prop wave_2 = 0
    prop wave_3 = 0
    prop wave_4 = 0

    wave wave_1 = 3.5 at 3.2
    wave wave_2 = 5.0 at 4.1
    wave wave_3 = 4.2 at 2.8
    wave wave_4 = 2.8 at 3.9

    // State-driven spring targets
    follow cur_y = if(phase == 2, expanded_y, if(phase == 1, compact_y, dormant_y))
    follow cur_w = if(phase == 2, expanded_w, if(phase == 1, compact_w, dormant_w))
    follow cur_h = if(phase == 2, expanded_h, if(phase == 1, compact_h, dormant_h))
    follow cur_corner = if(phase == 2, expanded_corner, if(phase == 1, compact_corner, dormant_corner))
    follow shadow_alpha = if(phase == 2, expanded_shadow_alpha, if(phase == 1, compact_shadow_alpha, 0.0))
    follow island_alpha = if(phase > 0, 1.0, 0.0)

    // Fluid height-based continuous alphas in both expand and retract
    let compact_alpha = if(cur_h < 60, clamp((cur_h - 25) / 11, 0, 1) * clamp(1 - (cur_h - 38) / 18, 0, 1), 0)
    let expanded_alpha = if(cur_h > 85, clamp((cur_h - 85) / 35, 0, 1), 0)

    // Dynamic horizontal center adapting to screen width
    let cx = screen.width / 2

    // ── Drawing Composition ───────────────────────────────────────
    group {
        opacity: island_alpha

        // 1. Smoked Glass Dynamic Island Body
        DynamicIslandBody(
            cx,
            cur_y,
            cur_w,
            cur_h,
            cur_corner,
            shadow_alpha,
            glass_base_color
        )

        // 2. Contained Content Layer: clipped strictly to current capsule geometry
        group {
            clip box {
                at: cx, cur_y
                size: cur_w, cur_h
                corner: cur_corner
            }

            // Compact View
            CompactView(
                cx,
                cur_y,
                now.time,
                island_date,
                wave_1,
                wave_2,
                wave_3,
                wave_4,
                compact_alpha,
                ink_primary,
                accent_primary
            )

            // Expanded View
            ExpandedView(
                cx,
                cur_y,
                track_title,
                track_artist,
                time_elapsed,
                time_remaining,
                media_progress,
                wave_1,
                wave_2,
                wave_3,
                wave_4,
                expanded_alpha,
                playing,
                ink_primary,
                ink_secondary,
                ink_muted,
                accent_primary
            )
        }
    }

    // ── Hit Zones & Input Routing ─────────────────────────────────
    // RULE: Outer grace area declared BEFORE interactive child buttons
    zone box grace_area {
        at: cx, grace_zone_y
        size: grace_zone_w, grace_zone_h
        corner: grace_zone_corner
        active: phase > 0
    }

    // Top-center wake strip: dormant state hover trigger
    zone box wake_strip {
        at: cx, wake_zone_y
        size: wake_zone_w, wake_zone_h
        corner: 5
        cursor: pointer
        active: phase == 0
        label: "Wake Island"
        role: button
    }

    // Compact button: click expands into wide card
    zone box compact_btn {
        at: cx, cur_y
        size: cur_w, cur_h
        corner: compact_corner
        cursor: pointer
        active: phase == 1
        label: "Open Island"
        role: button
    }

    // Expanded card zone: click background folds back to compact
    zone box expanded_card {
        at: cx, cur_y
        size: cur_w, cur_h
        corner: expanded_corner
        cursor: pointer
        active: phase == 2
        label: "Fold Island"
        role: button
    }

    // Scrubber track zone: click or drag to seek
    zone box scrub_track {
        at: cx, cur_y + 16
        size: scrubber_track_w, scrub_hit_h
        corner: scrub_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Scrub Media"
        role: slider
    }

    // Previous track button zone
    zone box prev_btn {
        at: cx - 52, cur_y + 46
        size: nav_btn_hit_size, nav_btn_hit_size
        corner: nav_btn_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Previous Track"
        role: button
    }

    // Play/Pause button zone
    zone ellipse play_btn {
        at: cx, cur_y + 46
        radius: play_btn_hit_r
        cursor: pointer
        active: phase == 2
        label: "Play or Pause"
        role: button
    }

    // Next track button zone
    zone box next_btn {
        at: cx + 52, cur_y + 46
        size: nav_btn_hit_size, nav_btn_hit_size
        corner: nav_btn_hit_corner
        cursor: pointer
        active: phase == 2
        label: "Next Track"
        role: button
    }

    // ── Renderer Event Rules ──────────────────────────────────────
    on enter wake_strip { phase = 1 }
    on press wake_strip { phase = 1 }
    on press compact_btn { phase = 2; emit open_wide }
    on press play_btn { emit media_toggle }
    on press prev_btn { emit media_prev }
    on press next_btn { emit media_next }
    on press scrub_track { emit media_seek(clamp((pointer.x - (cx - 142)) / 284, 0, 1)) }
    on drag scrub_track  { emit media_seek(clamp((pointer.x - (cx - 142)) / 284, 0, 1)) }
    on press expanded_card { phase = 1; emit fold_compact }
    on leave grace_area while phase == 1 { phase = 0 }
}
