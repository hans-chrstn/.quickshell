part UtilitySurface {
    surface utility_wake {
        size: 30, 760
        anchor: right
        level: overlay
        screens: each max 3
        keyboard: none

        zone box util_edge_wake {
            from: 0, 0
            size: 30, 760
            cursor: pointer
            active: util_phase == 0 or util_owner != screen.index
            label: "Open Utilities"
            role: button
        }

        on enter util_edge_wake {
            util_owner = screen.index
            util_phase = 1
        }

        on press util_edge_wake {
            util_owner = screen.index
            util_phase = 1
        }
    }

    surface utility {
        size: 720, 760
        margin: 0, -30, 0, 0
        anchor: right
        level: overlay
        screens: each max 3
        open: util_phase > 0 and util_owner == screen.index
        rate: 60
        keyboard: on_demand

        let util_screen_edge_x = utility_visible_edge_x
        let util_py = utility_center_y

        let util_side_active_cx = util_screen_edge_x - 12 - drum_pill_w / 2
        let util_side_dormant_cx = util_screen_edge_x - 4
        let util_side_dormant_w = 24
        let util_side_dormant_h = 140
        let util_side_dormant_corner = 12

        let util_target_w = if(util_center_tool == 1, util_audio_w, util_flyout_w)
        let util_target_h = if(util_center_tool == 1, if(audio_page == 0, util_audio_mixer_h, util_audio_h), util_flyout_h)
        let util_flyout_cx = util_side_active_cx - drum_pill_w / 2 - 12 - util_target_w / 2
        prop util_cur_x = 686 ~fluid
        prop util_cur_w = 24 ~fluid
        prop util_cur_h = 140 ~fluid
        prop util_cur_corner = 12 ~fluid
        prop util_rail_alpha = 0 ~fluid
        prop util_shadow_alpha = 0 ~calm
        prop util_drawer_alpha = 0 ~snappy
        prop util_drawer_content_alpha = 0 ~calm
        prop util_drawer_slide = -116 ~fluid
        prop util_drawer_w = 48 ~fluid
        prop util_drawer_h = 44 ~fluid
        prop util_drawer_corner = 24 ~fluid
        prop util_audio_page_mix = 0 ~snappy

        follow util_cur_x = if(util_phase > 0, util_side_active_cx, util_side_dormant_cx)
        follow util_cur_w = if(util_phase > 0, drum_pill_w, util_side_dormant_w)
        follow util_cur_h = if(util_phase > 0, drum_pill_h, util_side_dormant_h)
        follow util_cur_corner = if(util_phase > 0, drum_pill_corner, util_side_dormant_corner)
        follow util_rail_alpha = if(util_phase > 0, 1.0, 0.0)
        follow util_shadow_alpha = if(util_phase > 0, compact_shadow_alpha, 0.0)
        follow util_drawer_alpha = if(util_phase == 2, 1.0, 0.0)
        follow util_drawer_slide = if(util_phase == 2, 0.0, -(util_target_w - drum_pill_w) / 2)
        follow util_drawer_w = if(util_phase == 2, util_target_w, drum_pill_w)
        follow util_drawer_h = if(util_phase == 2, util_target_h, drum_slot_h)
        follow util_drawer_corner = if(util_phase == 2, util_flyout_corner, drum_pill_corner)
        follow util_audio_page_mix = audio_page

        on change util_phase while util_phase == 2 {
            util_drawer_content_alpha: 1 ~200ms after 90ms
        }

        on change util_phase while util_phase != 2 {
            util_drawer_content_alpha: 0 ~50ms
        }

        let util_drawer_cx = util_flyout_cx - util_drawer_slide
        let util_drawer_top = util_py - util_drawer_h / 2
        let util_rail_content_alpha = clamp((util_cur_w - 30) / 14, 0, 1)

        zone box util_grace_area {
            at: if(util_phase == 2, 360, util_screen_edge_x - 100), util_py
            size: if(util_phase == 2, 700, 240), if(util_phase == 2, 740, 660)
            active: util_phase > 0
        }

        zone box util_wall_tool {
            at: util_cur_x, util_py - 26
            size: util_cur_w, 46
            cursor: pointer
            active: util_phase > 0
            label: "Wallpaper Controls"
            role: button
            selected: util_center_tool == 0
        }

        zone box util_audio_tool {
            at: util_cur_x, util_py + 26
            size: util_cur_w, 46
            cursor: pointer
            active: util_phase > 0
            label: "Audio Controls"
            role: button
            selected: util_center_tool == 1
        }

        zone box util_flyout_esc {
            at: util_drawer_cx + util_drawer_w / 2 - 36, util_drawer_top + 40
            size: 32, 20
            cursor: pointer
            active: util_phase == 2 and util_drawer_content_alpha > 0.8
            label: "Close Flyout"
            role: button
        }

        zone box audio_mixer_tab {
            at: util_drawer_cx - 66, util_drawer_top + 82
            size: 128, 30
            corner: 10
            cursor: pointer
            active: util_phase == 2 and util_center_tool == 1 and util_drawer_content_alpha > 0.8
            label: "Show Audio Mixer"
            role: tab
            selected: audio_page == 0
        }

        zone box audio_devices_tab {
            at: util_drawer_cx + 66, util_drawer_top + 82
            size: 128, 30
            corner: 10
            cursor: pointer
            active: util_phase == 2 and util_center_tool == 1 and util_drawer_content_alpha > 0.8
            label: "Show Audio Devices"
            role: tab
            selected: audio_page == 1
        }

        group {
            show: util_drawer_alpha > 0.01 and util_center_tool == 0

            WallpaperStudioCard(
                util_flyout_cx,
                util_py,
                util_drawer_w,
                util_drawer_h,
                util_drawer_corner,
                util_drawer_slide,
                util_drawer_alpha,
                util_drawer_content_alpha,
                tool_name,
                wall_dir_path,
                wall_current_title,
                wall_mode_label,
                wall_mode == 1,
                wall_count,
                wall_current_idx,
                picker_open,
                picker_dir_text,
                picker_status,
                picker_page_text,
                prev_wallpaper,
                next_wallpaper,
                toggle_wall_mode,
                open_picker,
                picker_select_item,
                picker_nav_up,
                picker_prev_page,
                picker_next_page,
                picker_choose,
                picker_cancel
            ) {
                column {
                    at: util_flyout_cx - util_drawer_slide - 110, util_py - 60
                    gap: 4
                    view: 220, 190
                    step: 30
                    for it in picker_items {
                        group {
                            size: 220, 26
                            FilePickerRow(
                                it.id,
                                it.name,
                                it.is_dir,
                                220,
                                26,
                                picker_select_item,
                                picker_open and util_center_tool == 0 and util_phase == 2
                            )
                        }
                    }
                }
            }
        }

        group {
            show: util_drawer_alpha > 0.01 and util_center_tool == 1

            AudioStudioCard(
                util_flyout_cx,
                util_py,
                util_drawer_w,
                util_drawer_h,
                util_drawer_corner,
                util_drawer_slide,
                util_drawer_alpha,
                util_drawer_content_alpha,
                util_audio_page_mix,
                tool_name,
                tool_sub,
                audio_volume,
                audio_muted,
                volume_percent_text,
                mic_volume,
                mic_muted,
                mic_percent_text,
                audio_engine_status,
                toggle_mute,
                set_vol,
                toggle_mic_mute,
                set_mic
            ) {
                group {
                    show: util_audio_page_mix < 0.5
                    opacity: clamp(1.0 - util_audio_page_mix * 2.0, 0, 1)

                    column audio_apps_list {
                        at: util_drawer_cx - 244, util_drawer_top + 318
                        gap: 6
                        view: 488, util_drawer_h - 354
                        step: 70
                        for app in audio_apps {
                            AudioAppMixerRow(
                                app.id,
                                app.name,
                                app.title,
                                app.volume,
                                app.muted,
                                app.playing,
                                488,
                                64,
                                set_app_vol,
                                toggle_app_mute
                            )
                        }
                    }

                    box {
                        from: util_drawer_cx + 246, util_drawer_top + 318 + audio_apps_list.scroll / max(audio_apps_list.content, 1) * audio_apps_list.height
                        size: 3, max(audio_apps_list.height * audio_apps_list.height / max(audio_apps_list.content, audio_apps_list.height), 18)
                        corner: 1.5
                        color: hygge_sand
                        opacity: if(audio_apps_list.content > audio_apps_list.height, 0.45, 0)
                    }

                    text "No application audio streams" {
                        at: util_drawer_cx, util_drawer_top + 370
                        anchor: center
                        family: "SF Pro"
                        size: 12
                        weight: weight_medium
                        color: hygge_stone
                        show: audio_apps.count == 0
                    }
                }

                group {
                    show: util_audio_page_mix >= 0.5
                    opacity: clamp(util_audio_page_mix * 2.0 - 1.0, 0, 1)

                    column audio_outputs_list {
                        at: util_drawer_cx - 244, util_drawer_top + 132
                        gap: 6
                        view: 488, 220
                        step: 58
                        for s in sinks {
                            AudioDeviceChip(
                                s.id,
                                s.name,
                                s.is_default,
                                false,
                                488,
                                52,
                                pick_sink
                            )
                        }
                    }

                    column audio_inputs_list {
                        at: util_drawer_cx - 244, util_drawer_top + 414
                        gap: 6
                        view: 488, 220
                        step: 58
                        for s in sources {
                            AudioDeviceChip(
                                s.id,
                                s.name,
                                s.is_default,
                                true,
                                488,
                                52,
                                pick_source
                            )
                        }
                    }

                    box {
                        from: util_drawer_cx + 246, util_drawer_top + 132 + audio_outputs_list.scroll / max(audio_outputs_list.content, 1) * audio_outputs_list.height
                        size: 3, max(audio_outputs_list.height * audio_outputs_list.height / max(audio_outputs_list.content, audio_outputs_list.height), 18)
                        corner: 1.5
                        color: hygge_sand
                        opacity: if(audio_outputs_list.content > audio_outputs_list.height, 0.45, 0)
                    }

                    box {
                        from: util_drawer_cx + 246, util_drawer_top + 414 + audio_inputs_list.scroll / max(audio_inputs_list.content, 1) * audio_inputs_list.height
                        size: 3, max(audio_inputs_list.height * audio_inputs_list.height / max(audio_inputs_list.content, audio_inputs_list.height), 18)
                        corner: 1.5
                        color: hygge_sand
                        opacity: if(audio_inputs_list.content > audio_inputs_list.height, 0.45, 0)
                    }
                }
            }
        }

        group {
            show: util_phase > 0

            UtilityDrumRail(
                util_cur_x,
                util_py,
                util_cur_w,
                util_cur_h,
                util_cur_corner,
                util_rail_alpha,
                util_shadow_alpha,
                util_rail_content_alpha,
                util_center_tool
            )
        }

        on press util_wall_tool {
            util_center_tool = 0
            emit select_tool(0)
            util_phase = 2
        }

        on press util_audio_tool {
            util_center_tool = 1
            emit select_tool(1)
            util_phase = 2
        }

        on open_picker { picker_open = true }
        on picker_cancel { picker_open = false }
        on picker_choose { picker_open = false }

        on press util_flyout_esc while util_phase == 2 and picker_open { picker_open = false }
        on press util_flyout_esc while util_phase == 2 and picker_open == false { util_phase = 1 }
        on key Escape while util_phase == 2 and picker_open { picker_open = false }
        on key Escape while util_phase == 2 and picker_open == false { util_phase = 1 }
        on leave util_grace_area while util_phase == 1 { util_phase = 0 }

        on key Up while util_phase > 0 { util_center_tool = 0; emit select_tool(0) }
        on key Down while util_phase > 0 { util_center_tool = 1; emit select_tool(1) }
        on key Right while util_phase == 1 { util_phase = 2 }
        on key Left while util_phase == 2 { util_phase = 1 }
        on press audio_mixer_tab { audio_page = 0 }
        on press audio_devices_tab { audio_page = 1 }
    }
}
