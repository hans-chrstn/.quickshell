import "../common/Theme.plm"

library SideUtilityLib {
    component ToolIconVector(tool_id: number, cx: number, cy: number, is_center: bool) {
        let pri_col = if(is_center, hygge_linen, hygge_sand)
        let sec_col = if(is_center, hygge_sand, hygge_stone)

        group {
            show: tool_id == 0
            box {
                at: cx, cy
                size: 18, 14
                corner: 3
                stroke: 1.5
                color: if(is_center, hygge_clay, hygge_stone)
            }
            ellipse {
                at: cx - 3, cy - 2
                radius: 2.0
                color: if(is_center, hygge_honey, hygge_stone)
            }
            path {
                at: cx, cy + 3
                color: if(is_center, hygge_sage, hygge_stone)
                move -6, 2
                line -2, -2
                line 2, 1
                line 5, -2
                line 6, 2
                close
            }
        }

        group {
            show: tool_id == 1
            box {
                at: cx - 4, cy
                size: 5, 8
                corner: 1.5
                color: if(is_center, hygge_honey, sec_col)
            }
            path {
                at: cx, cy
                color: if(is_center, hygge_honey, sec_col)
                move -2, -3
                line 3, -6
                line 3, 6
                line -2, 3
                close
            }
            arc {
                at: cx + 1, cy
                radius: 4.5
                span: 120deg
                rotate: -90deg
                width: 1.5
                color: pri_col
            }
            arc {
                at: cx + 3, cy
                radius: 7.5
                span: 110deg
                rotate: -90deg
                width: 1.5
                color: if(is_center, hygge_honey, sec_col)
            }
        }

        group {
            show: tool_id == 2
            box {
                at: cx, cy - 2
                size: 16, 12
                corner: 2.5
                stroke: 1.5
                color: if(is_center, hygge_sage, sec_col)
            }
            line {
                from: cx, cy + 4
                to: cx, cy + 7
                width: 1.5
                color: sec_col
            }
            box {
                at: cx, cy + 7
                size: 8, 1.5
                corner: 0.5
                color: sec_col
            }
            ellipse {
                at: cx + 3, cy - 4
                radius: 1.8
                color: if(is_center, hygge_honey, pri_col)
            }
        }

        group {
            show: tool_id == 3
            box {
                at: cx - 1, cy
                size: 17, 10
                corner: 2.5
                stroke: 1.5
                color: if(is_center, hygge_terracotta, sec_col)
            }
            box {
                at: cx + 8.5, cy
                size: 2, 4
                corner: 1
                color: if(is_center, hygge_terracotta, sec_col)
            }
            path {
                at: cx - 1, cy
                color: if(is_center, hygge_honey, pri_col)
                move 1, -3
                line -2, 1
                line 0, 1
                line -1, 3
                line 2, -1
                line 0, -1
                close
            }
        }

        group {
            show: tool_id == 4
            ellipse {
                at: cx, cy
                radius: 6.0
                stroke: 1.5
                color: if(is_center, hygge_flax, sec_col)
            }
            ellipse {
                at: cx, cy
                radius: 2.2
                color: if(is_center, hygge_honey, pri_col)
            }
            box {
                at: cx, cy - 7
                size: 2.5, 2
                corner: 0.5
                color: if(is_center, hygge_flax, sec_col)
            }
            box {
                at: cx, cy + 7
                size: 2.5, 2
                corner: 0.5
                color: if(is_center, hygge_flax, sec_col)
            }
            box {
                at: cx - 7, cy
                size: 2, 2.5
                corner: 0.5
                color: if(is_center, hygge_flax, sec_col)
            }
            box {
                at: cx + 7, cy
                size: 2, 2.5
                corner: 0.5
                color: if(is_center, hygge_flax, sec_col)
            }
        }
    }

    component AudioSlider(cx: number, cy: number, w: number, h: number, val: number, is_muted: bool, seek_evt: event) {
        let fill_w = max(w * clamp(val / 100, 0, 1), h)
        let knob_x = cx - w / 2 + w * clamp(val / 100, 0, 1)

        box {
            at: cx, cy
            size: w, h
            corner: h / 2
            color: hygge_track
        }

        box {
            from: cx - w / 2, cy - h / 2
            size: fill_w, h
            corner: h / 2
            color: if(is_muted, hygge_stone, hygge_honey)
            opacity: if(is_muted, 0.6, 1.0)
        }

        ellipse {
            at: knob_x, cy
            radius: h * 0.85
            color: if(is_muted, hygge_sand, hygge_linen)
        }

        zone box slider_hit {
            at: cx, cy
            size: w, h + 16
            cursor: pointer
            role: slider
            label: "Adjust Audio Level"
        }

        on press slider_hit { emit seek_evt(clamp((pointer.x - (cx - w / 2)) / w * 100, 0, 100)) }
        on drag slider_hit { emit seek_evt(clamp((pointer.x - (cx - w / 2)) / w * 100, 0, 100)) }
    }

    component AudioMuteBtn(cx: number, cy: number, is_muted: bool, mute_evt: event) {
        box {
            at: cx, cy
            size: 32, 32
            corner: 16
            color: if(is_muted, hygge_terracotta, hygge_card)
            opacity: if(is_muted, 0.95, 0.85)
        }

        box {
            at: cx - 4, cy
            size: 4, 8
            corner: 1
            color: if(is_muted, hygge_linen, hygge_sand)
        }

        path {
            at: cx, cy
            color: if(is_muted, hygge_linen, hygge_sand)
            move -2, -4
            line 3, -7
            line 3, 7
            line -2, 4
            close
        }

        group {
            show: not is_muted
            arc {
                at: cx + 1, cy
                radius: 4.5
                span: 120deg
                rotate: -90deg
                width: 1.5
                color: hygge_honey
            }
            arc {
                at: cx + 3, cy
                radius: 7.5
                span: 110deg
                rotate: -90deg
                width: 1.5
                color: hygge_honey
            }
        }

        group {
            show: is_muted
            line {
                from: cx - 7, cy - 7
                to: cx + 7, cy + 7
                width: 1.8
                color: hygge_linen
            }
        }

        zone box mute_hit {
            at: cx, cy
            size: 32, 32
            cursor: pointer
            role: button
            label: "Toggle Audio Mute"
        }

        on press mute_hit { emit mute_evt }
    }

    component AudioDeviceChip(device_id: number, device_name: text, is_active: bool, is_input: bool, card_w: number, card_h: number, sel_evt: event) {
        size: card_w, card_h

        box card_hit {
            from: 0, 0
            size: card_w, card_h
            corner: 10
            color: if(is_active, hygge_card_hover, hygge_card)
            opacity: if(is_active, 1.0, 0.70)
            cursor: pointer
            label: if(is_input, "Select Input Device", "Select Output Device")
            role: button
        }

        box {
            from: 0, 6
            size: 3, card_h - 12
            corner: 1.5
            color: hygge_clay
            opacity: if(is_active, 1.0, 0.0)
        }

        box {
            at: 20, card_h / 2
            size: 3.5, 6
            corner: 1
            color: if(is_active, hygge_clay, hygge_stone)
        }

        path {
            at: 23.5, card_h / 2
            color: if(is_active, hygge_clay, hygge_stone)
            move -2, -2.5
            line 2.5, -5
            line 2.5, 5
            line -2, 2.5
            close
        }

        text device_name {
            at: 38, card_h / 2 - 7
            anchor: left center
            family: "SF Pro"
            size: 12
            weight: if(is_active, weight_semibold, weight_medium)
            color: if(is_active, hygge_linen, hygge_sand)
            width: card_w - 76
            lines: 1
        }

        text pick(is_input * 2 + is_active, "OUTPUT", "ACTIVE OUTPUT", "INPUT", "ACTIVE INPUT") {
            at: 38, card_h / 2 + 9
            anchor: left center
            family: "SF Mono"
            size: 8
            weight: weight_medium
            color: if(is_active, hygge_clay, hygge_stone)
        }

        ellipse {
            at: card_w - 20, card_h / 2
            radius: 3
            color: if(is_active, hygge_clay, hygge_stone)
        }

        on press card_hit { emit sel_evt(device_id) }
    }

    component AudioAppMixerRow(
        app_id: number,
        app_name: text,
        app_title: text,
        app_volume: number,
        is_muted: bool,
        is_playing: bool,
        card_w: number,
        card_h: number,
        volume_evt: event,
        mute_evt: event
    ) {
        size: card_w, card_h

        box {
            from: 0, 0
            size: card_w, card_h
            corner: 14
            color: hygge_card
            opacity: 0.76
        }

        box {
            at: 22, card_h / 2
            size: 32, 32
            corner: 8
            color: if(is_playing, hygge_card_hover, hygge_track)
        }

        ellipse {
            at: 22, card_h / 2
            radius: 4.5
            color: if(is_playing, hygge_honey, hygge_stone)
        }

        text app_name {
            at: 46, 17
            anchor: left center
            family: "SF Pro"
            size: 12
            weight: weight_semibold
            color: hygge_linen
            width: card_w - 146
            lines: 1
        }

        text app_title {
            at: 46, 34
            anchor: left center
            family: "SF Pro"
            size: 9
            weight: weight_regular
            color: hygge_stone
            width: card_w - 146
            lines: 1
        }

        text number(app_volume, 0, "%") {
            at: card_w - 56, 17
            anchor: right center
            family: "SF Mono"
            size: 9
            weight: weight_semibold
            color: if(is_muted, hygge_terracotta, hygge_sand)
        }

        box {
            from: 46, 50
            size: card_w - 122, 5
            corner: 2.5
            color: hygge_track
        }

        box {
            from: 46, 50
            size: max((card_w - 122) * clamp(app_volume / 100, 0, 1), 5), 5
            corner: 2.5
            color: if(is_muted, hygge_stone, hygge_honey)
        }

        ellipse {
            at: 46 + (card_w - 122) * clamp(app_volume / 100, 0, 1), 52.5
            radius: 4.5
            color: hygge_linen
        }

        zone box app_slider_hit {
            from: 46, 42
            size: card_w - 122, 20
            cursor: pointer
            label: "Adjust Application Volume"
            role: slider
        }

        box app_mute_hit {
            at: card_w - 26, card_h / 2
            size: 32, 32
            corner: 16
            color: if(is_muted, hygge_terracotta, hygge_track)
            opacity: 0.92
            cursor: pointer
            label: "Toggle Application Mute"
            role: button
        }

        line {
            from: card_w - 32, card_h / 2
            to: card_w - 20, card_h / 2
            width: 2
            color: hygge_linen
        }

        on press app_slider_hit {
            emit volume_evt(app_id * 1000 + clamp((pointer.x - 46) / (card_w - 122) * 100, 0, 100))
        }
        on drag app_slider_hit {
            emit volume_evt(app_id * 1000 + clamp((pointer.x - 46) / (card_w - 122) * 100, 0, 100))
        }
        on press app_mute_hit { emit mute_evt(app_id) }
    }
}
