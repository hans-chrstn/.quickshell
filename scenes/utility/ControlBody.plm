import "../common/Theme.plm"
import "../common/components/controls.plm"
import "../common/components/search.plm"
import "../common/components/glyphs.plm"
import "../common/components/nac-controls.plm"

library ControlBodyLib {
    component ControlBody {
        let rail_w = 80
        let rail_h = 168
        let audio_w = 440
        let device_count = if(cc_page == 1, sinks.count, sources.count)
        let play_visible = min(4, play_rows.count)
        let rec_visible = min(2, rec_rows.count)
        let picker_count = if(pick_kind == 1, sinks.count, sources.count)
        let picker_h = clamp(88 + max(1, picker_count) * 56, 200, 448)
        let apps_h = if(pick_kind > 0, 600, clamp(320 + max(1, play_visible) * 64 + max(1, rec_visible) * 64, 448, 600))
        let audio_h = if(cc_page == 1 or cc_page == 2, clamp(240 + max(1, device_count) * 56, 360, 600), if(cc_page == 3, apps_h, 600))
        let wall_w = 440
        let wall_h = 420
        let right_edge = screen.width - 16
        let cy = 340

        prop cur_w = 0 ~900ms
        prop cur_h = 0 ~900ms
        prop audio_show = 0 ~fluid
        prop wall_show = 0 ~fluid
        prop pick_show = 0 ~lively
        prop pg0 = 0 ~calm
        prop pg1 = 0 ~calm
        prop pg2 = 0 ~calm
        prop pg3 = 0 ~calm

        follow cur_w = if(cc.$screen.phase == 0, 0, if(cc.$screen.phase == 1, rail_w, if(cc.$screen.phase == 2, audio_w, wall_w)))
        follow cur_h = if(cc.$screen.phase == 0, 0, if(cc.$screen.phase == 1, rail_h, if(cc.$screen.phase == 2, audio_h, wall_h)))
        follow audio_show = if(cc.$screen.phase == 2, 1, 0)
        follow wall_show = if(cc.$screen.phase == 3, 1, 0)
        follow pick_show = if(pick_kind > 0, 1, 0)
        follow pg0 = if(cc_page == 0, 1, 0)
        follow pg1 = if(cc_page == 1, 1, 0)
        follow pg2 = if(cc_page == 2, 1, 0)
        follow pg3 = if(cc_page == 3, 1, 0)

        let alpha = clamp(cur_h / rail_h, 0, 1)
        let edge_depart = (rail_w + 40) * (1 - alpha)
        let cx = right_edge - cur_w / 2 + edge_depart
        let sheet_cx = right_edge - 220 + edge_depart
        let sheet_top = cy - cur_h / 2
        let corner = min(cur_h / 2, 28)
        let rail_alpha = clamp(1 - max(0, cur_w - 84) / 60, 0, 1)
        let sheet_alpha = clamp((cur_w - 96) / 64, 0, 1)

        zone box grace_area {
            at: cx, cy
            size: cur_w + 60, cur_h + 80
            corner: 44
            active: cc.$screen.phase > 0
            label: "Control Centre Area"
            role: region
        }

        on enter grace_area { cc.$screen.grace_in = 1 }
        on leave grace_area { cc.$screen.grace_in = 0 }
        on leave grace_area while cc.$screen.phase > 0 { cc.$screen.phase = 0; cc_awake = max(0, cc_awake - 1); emit cc_wake_evt(0) }

        zone box sheet_fold_btn {
            at: cx, cy
            size: cur_w, cur_h
            corner: corner
            cursor: pointer
            active: cc.$screen.phase > 1
            label: "Fold Control Centre"
            role: button
        }
        on press sheet_fold_btn { cc.$screen.phase = 1 }

        RevealEdge(cx, cy, cur_w, cur_h, corner, alpha, 0.5 * alpha) {
            group {
                opacity: rail_alpha

                NacIcon(cx, cy - 28, 24, 1, cc.$screen.phase == 2)
                NacIcon(cx, cy + 28, 24, 2, cc.$screen.phase == 3)
            }

                group {
                    show: audio_show > 0.5
                    opacity: sheet_alpha * audio_show

                    text "Audio" {
                        at: sheet_cx - 204, sheet_top + 28
                        anchor: left center
                        family: "SF Pro"
                        size: nacre_fs16
                        weight: nacre_w600
                        color: nacre_ink
                    }
                    EscBadge(sheet_cx + 192, sheet_top + 28)

                    box {
                        at: sheet_cx, sheet_top + 52
                        size: 408, 1
                        color: nacre_ink
                        opacity: 0.10
                    }

                    NacTab(sheet_cx - 144, sheet_top + 84, 84, "LEVELS", cc_page == 0, cc_tab_levels)
                    NacTab(sheet_cx - 48, sheet_top + 84, 84, "OUTPUT", cc_page == 1, cc_tab_out)
                    NacTab(sheet_cx + 48, sheet_top + 84, 84, "INPUT", cc_page == 2, cc_tab_in)
                    NacTab(sheet_cx + 144, sheet_top + 84, 84, "APPS", cc_page == 3, cc_tab_apps)

                    group {
                        show: pg0 > 0.01
                        opacity: pg0
                        move: 0, 10 * (1 - pg0)

                        box {
                            at: sheet_cx, cy - 40
                            size: 408, 140
                            corner: 14
                            color: nacre_ink
                            opacity: 0.05
                        }
                        NacMuteBtn(sheet_cx - 172, cy - 74, audio_muted, cc_mute)
                        text "Output" {
                            at: sheet_cx - 144, cy - 74
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs13
                            weight: nacre_w500
                            color: nacre_ink
                        }
                        NacSlider(sheet_cx + 64, cy - 74, 170, 6, audio_volume, audio_muted, cc_vol)
                        text volume_percent_text {
                            at: sheet_cx + 184, cy - 74
                            anchor: right center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                        }
                        NacMeter(sheet_cx, cy - 34, 368, 8, out_level)
                        text active_sink_name {
                            at: sheet_cx - 172, cy - 2
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                            width: 376
                            lines: 1
                            show: has_sink
                        }
                        text "No default output" {
                            at: sheet_cx - 172, cy - 2
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_faint
                            show: not has_sink
                        }

                        box {
                            at: sheet_cx, cy + 108
                            size: 408, 108
                            corner: 14
                            color: nacre_ink
                            opacity: 0.05
                        }
                        NacMicBtn(sheet_cx - 172, cy + 74, mic_muted, cc_mic_mute)
                        text "Microphone" {
                            at: sheet_cx - 144, cy + 74
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs13
                            weight: nacre_w500
                            color: nacre_ink
                        }
                        NacSlider(sheet_cx + 64, cy + 74, 170, 6, mic_volume, mic_muted, cc_mic)
                        text mic_percent_text {
                            at: sheet_cx + 184, cy + 74
                            anchor: right center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                        }
                        text active_source_name {
                            at: sheet_cx - 172, cy + 142
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                            width: 376
                            lines: 1
                            show: has_source
                        }
                        text "No default input" {
                            at: sheet_cx - 172, cy + 142
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_faint
                            show: not has_source
                        }

                        box {
                            at: sheet_cx, cy + 186
                            size: 408, 1
                            color: nacre_ink
                            opacity: 0.10
                        }
                        text "DEFAULT OUTPUT" {
                            at: sheet_cx - 102, cy + 210
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        text "DEFAULT INPUT" {
                            at: sheet_cx + 102, cy + 210
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        text active_sink_name {
                            at: sheet_cx - 102, cy + 234
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                            width: 180
                            lines: 1
                            show: has_sink
                        }
                        text "None" {
                            at: sheet_cx - 102, cy + 234
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_faint
                            show: not has_sink
                        }
                        text active_source_name {
                            at: sheet_cx + 102, cy + 234
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_soft
                            width: 92
                            lines: 1
                            show: has_source
                        }
                        text "None" {
                            at: sheet_cx + 102, cy + 234
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs11
                            weight: nacre_w500
                            color: nacre_ink_faint
                            show: not has_source
                        }
                    }

                    group {
                        show: pg1 > 0.01
                        opacity: pg1
                        move: 0, 10 * (1 - pg1)

                        text "OUTPUTS" {
                            at: sheet_cx - 204, sheet_top + 136
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        column out_grid {
                            at: sheet_cx - 204, sheet_top + 160
                            gap: 8
                            view: 408, audio_h - 184
                            step: 56
                            for d in sinks {
                                NacChip(d, 408, selected_sink == d.id, cc_pick_sink)
                            }
                        }
                        group {
                            show: sinks.count == 0
                            text "No output devices" {
                                at: sheet_cx - 204, sheet_top + 164
                                anchor: left center
                                family: "SF Mono"
                                size: nacre_fs11
                                weight: nacre_w500
                                color: nacre_ink_faint
                            }
                        }
                    }

                    group {
                        show: pg2 > 0.01
                        opacity: pg2
                        move: 0, 10 * (1 - pg2)

                        text "INPUTS" {
                            at: sheet_cx - 204, sheet_top + 136
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        column in_grid {
                            at: sheet_cx - 204, sheet_top + 160
                            gap: 8
                            view: 408, audio_h - 184
                            step: 56
                            for s in sources {
                                NacChip(s, 408, selected_source == s.id, cc_pick_source, true)
                            }
                        }
                        group {
                            show: sources.count == 0
                            text "No input devices" {
                                at: sheet_cx - 204, sheet_top + 164
                                anchor: left center
                                family: "SF Mono"
                                size: nacre_fs11
                                weight: nacre_w500
                                color: nacre_ink_faint
                            }
                        }
                    }

                    group {
                        show: pg3 > 0.01
                        opacity: pg3
                        move: 0, 10 * (1 - pg3)

                        text "PLAYING" {
                            at: sheet_cx - 204, sheet_top + 132
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        group {
                            show: play_rows.count == 0
                            text "Nothing is playing" {
                                at: sheet_cx - 204, sheet_top + 164
                                anchor: left center
                                family: "SF Mono"
                                size: nacre_fs11
                                weight: nacre_w500
                                color: nacre_ink_faint
                            }
                        }
                        column play_grid {
                            at: sheet_cx - 204, sheet_top + 148
                            gap: 8
                            view: 408, 280
                            step: 64
                            for p in play_rows {
                                NacMixRow(p, cc_app_vol, cc_app_mute, cc_route_open)
                            }
                        }

                        text "RECORDING" {
                            at: sheet_cx - 204, sheet_top + 208 + max(1, play_visible) * 64
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                        }
                        group {
                            show: rec_rows.count == 0
                            text "No apps are recording" {
                                at: sheet_cx - 204, sheet_top + 240 + max(1, play_visible) * 64
                                anchor: left center
                                family: "SF Mono"
                                size: nacre_fs11
                                weight: nacre_w500
                                color: nacre_ink_faint
                            }
                        }
                        column rec_grid {
                            at: sheet_cx - 204, sheet_top + 224 + max(1, play_visible) * 64
                            gap: 8
                            view: 408, 104
                            step: 64
                            for r in rec_rows {
                                NacMixRow(r, cc_app_vol, cc_app_mute, cc_route_open)
                            }
                        }
                    }

                    group {
                        show: pick_show > 0.01
                        opacity: pick_show
                        move: 0, 14 * (1 - pick_show)

                        zone box picker_shield {
                            at: sheet_cx, cy
                            size: 440, 600
                            active: pick_kind > 0
                            role: region
                            label: "Choose an audio device"
                        }

                        box {
                            at: sheet_cx, cy
                            size: 440, 600
                            corner: 28
                            color: nacre_glass_base
                            opacity: 0.58
                        }
                        box {
                            at: sheet_cx, cy - 200 + picker_h / 2
                            size: 424, picker_h
                            corner: 16
                            color: nacre_glass_base
                            opacity: 0.995
                        }
                        box {
                            at: sheet_cx, cy - 200 + picker_h / 2
                            size: 424, picker_h
                            corner: 16
                            stroke: 1
                            color: nacre_ink
                            opacity: 0.18
                        }
                        text "SEND TO" {
                            at: sheet_cx - 188, cy - 158
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                            show: pick_kind == 1
                        }
                        text "RECORD FROM" {
                            at: sheet_cx - 188, cy - 158
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs9
                            weight: nacre_w700
                            color: nacre_ink_faint
                            show: pick_kind == 2
                        }
                        text "Cancel" {
                            at: sheet_cx + 188, cy - 158
                            anchor: right center
                            family: "SF Pro"
                            size: nacre_fs11
                            weight: nacre_w600
                            color: nacre_ink_soft
                        }
                        group {
                            show: pick_kind == 1
                            column pick_out_grid {
                                at: sheet_cx - 204, cy - 136
                                gap: 8
                                view: 408, picker_h - 80
                                step: 56
                                for d in sinks {
                                    NacChip(d, 408, false, cc_route_pick)
                                }
                            }
                        }
                        group {
                            show: pick_kind == 2
                            column pick_in_grid {
                                at: sheet_cx - 204, cy - 136
                                gap: 8
                                view: 408, picker_h - 80
                                step: 56
                                for s in sources {
                                    NacChip(s, 408, false, cc_route_pick, true)
                                }
                            }
                        }
                    }
                }

                group {
                    show: wall_show > 0.5
                    opacity: sheet_alpha * wall_show

                    text "Wallpaper" {
                        at: sheet_cx - 204, cy - 178
                        anchor: left center
                        family: "SF Pro"
                        size: nacre_fs16
                        weight: nacre_w600
                        color: nacre_ink
                    }
                    EscBadge(sheet_cx + 192, cy - 178)

                    box {
                        at: sheet_cx, cy - 154
                        size: 408, 1
                        color: nacre_ink
                        opacity: 0.10
                        show: not picker_open
                    }

                    group {
                        show: not picker_open

                        group {
                            clip box {
                                at: sheet_cx, cy - 62
                                size: 408, 168
                                corner: 12
                            }
                            box {
                                at: sheet_cx, cy - 62
                                size: 408, 168
                                color: nacre_ink
                                opacity: 0.06
                            }
                            group {
                                show: wall_count > 0
                                image wall_prev {
                                    at: sheet_cx - 204, cy - 146
                                    size: 408, 168
                                    fit: cover
                                }
                            }
                            group {
                                show: wall_count == 0
                                NacGlyph(2, sheet_cx, cy - 74, nacre_warm)
                                text "No wallpapers found" {
                                    at: sheet_cx, cy - 44
                                    anchor: center
                                    family: "SF Pro"
                                    size: nacre_fs12
                                    weight: nacre_w400
                                    color: nacre_ink_faint
                                }
                            }
                        }

                        text wall_title {
                            at: sheet_cx - 204, cy + 52
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs14
                            weight: nacre_w600
                            color: nacre_ink
                            width: 300
                            lines: 1
                        }
                        text if(wall_count > 0, "Library", "No wallpapers found") {
                            at: sheet_cx - 204, cy + 78
                            anchor: left center
                            family: "SF Pro"
                            size: nacre_fs11
                            weight: nacre_w400
                            color: nacre_ink_faint
                        }

                        box {
                            at: sheet_cx + 120, cy + 132
                            size: 96, 36
                            corner: 18
                            color: nacre_accent
                            opacity: 0.14
                            show: wall_count > 0
                        }
                        text "Set" {
                            at: sheet_cx + 120, cy + 132
                            anchor: center
                            family: "SF Pro"
                            size: nacre_fs12
                            weight: nacre_w600
                            color: nacre_accent
                            show: wall_count > 0
                        }

                        NacChevron(sheet_cx + 160, cy + 52, 13, true)
                        NacChevron(sheet_cx + 196, cy + 52, 13, false)

                        box {
                            at: sheet_cx - 160, cy + 132
                            size: 96, 36
                            corner: 18
                            color: nacre_accent
                            opacity: 0.14
                        }
                        text "Browse" {
                            at: sheet_cx - 160, cy + 132
                            anchor: center
                            family: "SF Pro"
                            size: nacre_fs12
                            weight: nacre_w600
                            color: nacre_accent
                        }
                    }

                    group {
                        show: picker_open

                        box {
                            at: sheet_cx - 192, cy - 128
                            size: 24, 24
                            corner: 12
                            color: nacre_ink
                            opacity: 0.08
                        }
                        NacGlyph(4, sheet_cx - 192, cy - 128, nacre_ink)

                        text picker_dir_text {
                            at: sheet_cx - 176, cy - 128
                            anchor: left center
                            family: "SF Mono"
                            size: nacre_fs12
                            weight: nacre_w500
                            color: nacre_ink_soft
                            width: 240
                            lines: 1
                        }

                        box {
                            at: sheet_cx + 164, cy - 128
                            size: 72, 24
                            corner: 12
                            color: nacre_ink
                            opacity: 0.08
                        }
                        text "Cancel" {
                            at: sheet_cx + 164, cy - 128
                            anchor: center
                            family: "SF Pro"
                            size: nacre_fs11
                            weight: nacre_w600
                            color: nacre_ink_soft
                        }

                        column picker_grid {
                            at: sheet_cx - 204, cy - 100
                            gap: 6
                            view: 408, 248
                            step: 46
                            for it in picker_items {
                                NacFileRow(it.id, it.name, it.is_dir, 408, picker_select_item)
                            }
                        }
                    }
                }
        }

        zone box rail_audio_hit {
            at: cx, cy - 28
            size: 48, 48
            corner: 24
            cursor: pointer
            active: cc.$screen.phase == 1
            label: "Open Audio Settings"
            role: button
        }
        zone box rail_wall_hit {
            at: cx, cy + 28
            size: 48, 48
            corner: 24
            cursor: pointer
            active: cc.$screen.phase == 1
            label: "Open Wallpaper Settings"
            role: button
        }
        on press rail_audio_hit { cc.$screen.phase = 2 }
        on press rail_wall_hit { cc.$screen.phase = 3 }

        zone box a_close {
            at: sheet_cx + 192, sheet_top + 28
            size: 36, 20
            corner: 6
            cursor: pointer
            active: cc.$screen.phase == 2
            label: "Close Audio Settings"
            role: button
        }
        on press a_close { cc.$screen.phase = 1 }

        zone box w_close {
            at: sheet_cx + 192, cy - 178
            size: 36, 20
            corner: 6
            cursor: pointer
            active: cc.$screen.phase == 3
            label: "Close Wallpaper Settings"
            role: button
        }
        on press w_close { cc.$screen.phase = 1 }

        zone box pick_cancel {
            at: sheet_cx + 188, cy - 158
            size: 72, 24
            corner: 12
            cursor: pointer
            active: cc.$screen.phase == 2 and pick_kind > 0
            label: "Cancel Device Picker"
            role: button
        }
        on press pick_cancel { emit cc_route_cancel }

        zone box w_prev {
            at: sheet_cx + 160, cy + 52
            size: 30, 30
            corner: 15
            cursor: pointer
            active: cc.$screen.phase == 3
            label: "Previous Wallpaper"
            role: button
        }
        zone box w_next {
            at: sheet_cx + 196, cy + 52
            size: 30, 30
            corner: 15
            cursor: pointer
            active: cc.$screen.phase == 3
            label: "Next Wallpaper"
            role: button
        }
        on press w_prev { emit cc_wall_prev }
        on press w_next { emit cc_wall_next }

        zone box w_apply {
            at: sheet_cx + 120, cy + 132
            size: 96, 36
            corner: 18
            cursor: pointer
            active: cc.$screen.phase == 3 and wall_count > 0
            label: "Set Desktop Wallpaper"
            role: button
        }
        on press w_apply { emit cc_wall_apply }

        zone box w_browse {
            at: sheet_cx - 160, cy + 132
            size: 96, 36
            corner: 18
            cursor: pointer
            active: cc.$screen.phase == 3
            label: "Browse Wallpapers"
            role: button
        }
        on press w_browse { emit cc_browse }

        zone box p_up {
            at: sheet_cx - 192, cy - 128
            size: 24, 24
            corner: 12
            cursor: pointer
            active: cc.$screen.phase == 3 and picker_open
            label: "Up One Level"
            role: button
        }
        on press p_up { emit picker_nav_up }

        zone box p_cancel {
            at: sheet_cx + 164, cy - 128
            size: 72, 24
            corner: 12
            cursor: pointer
            active: cc.$screen.phase == 3 and picker_open
            label: "Cancel"
            role: button
        }
        on press p_cancel { emit picker_cancel }

        on change cur_w { cc_settling = 1 }
        on still cur_w for 120ms { cc_settling = 0 }
    }
}
