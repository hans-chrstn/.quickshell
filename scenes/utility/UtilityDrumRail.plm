import "../common/Theme.plm"
import "../common/GlassBody.plm"
import "SideUtilityView.plm"

library UtilityDrumRailLib {
    component UtilityDrumRail(
        cx: number,
        cy: number,
        w: number,
        h: number,
        corner: number,
        rail_alpha: number,
        shadow_alpha: number,
        content_alpha: number,
        selected_tool: number
    ) {
        group {
            opacity: rail_alpha

            UtilityGlassBody(cx, cy, w, h, corner, shadow_alpha)

            box {
                at: cx, cy - 26 + selected_tool * 52
                size: 38, 38
                corner: 19
                color: hygge_card_hover
                opacity: content_alpha
            }

            box {
                at: cx, cy - 26 + selected_tool * 52
                size: 38, 38
                corner: 19
                stroke: 1
                color: hygge_honey
                opacity: content_alpha * 0.52
            }

            group {
                opacity: content_alpha
                ToolIconVector(0, cx, cy - 26, selected_tool == 0)
                ToolIconVector(1, cx, cy + 26, selected_tool == 1)
            }

            ellipse {
                at: cx, cy + h / 2 - 11
                radius: 2
                color: hygge_stone
                opacity: content_alpha * 0.58
            }
        }
    }
}
