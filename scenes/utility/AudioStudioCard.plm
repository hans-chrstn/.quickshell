import "../common/Theme.plm"
import "../common/Primitives.plm"
import "../common/GlassBody.plm"
import "SideUtilityView.plm"

library AudioStudioCardLib {
    component AudioStudioCard(
        cx: number,
        cy: number,
        card_w: number,
        card_h: number,
        corner: number,
        slide_x: number,
        alpha: number,
        content_alpha: number,
        page_mix: number,
        tool_title: text,
        tool_subtitle: text,
        vol: number,
        vol_muted: bool,
        vol_text: text,
        mic_vol: number,
        mic_muted: bool,
        mic_text: text,
        engine_status: text,
        toggle_mute_evt: event,
        set_vol_evt: event,
        toggle_mic_mute_evt: event,
        set_mic_evt: event
    ) {
        let card_cx = cx - slide_x
        let card_left = card_cx - card_w / 2
        let card_top = cy - card_h / 2

        group {
            opacity: alpha

            UtilityGlassBody(card_cx, cy, card_w, card_h, corner, 1.0)

            group {
                opacity: content_alpha

                clip box {
                    at: card_cx, cy
                    size: card_w, card_h
                    corner: corner
                }

                text tool_title {
                    at: card_left + 20, card_top + 34
                    anchor: left center
                    family: "SF Pro"
                    size: 16
                    weight: weight_bold
                    color: hygge_linen
                }

                text tool_subtitle {
                    at: card_left + 20, card_top + 52
                    anchor: left center
                    family: "SF Pro"
                    size: 10
                    weight: weight_medium
                    color: hygge_sand
                    width: card_w - 92
                    lines: 1
                }

                EscBadge(card_cx + card_w / 2 - 36, card_top + 40, 32, 20, 6, badge_bg, hygge_stone)

                box {
                    at: card_cx, card_top + 82
                    size: 264, 32
                    corner: 11
                    color: hygge_track
                    opacity: 0.72
                }

                box {
                    at: card_cx - 66 + page_mix * 132, card_top + 82
                    size: 128, 28
                    corner: 9
                    color: hygge_card_hover
                    opacity: 0.96
                }

                text "Mixer" {
                    at: card_cx - 66, card_top + 82
                    anchor: center
                    family: "SF Pro"
                    size: 11
                    weight: if(page_mix < 0.5, weight_semibold, weight_medium)
                    color: mix(hygge_linen, hygge_stone, page_mix)
                }

                text "Devices" {
                    at: card_cx + 66, card_top + 82
                    anchor: center
                    family: "SF Pro"
                    size: 11
                    weight: if(page_mix >= 0.5, weight_semibold, weight_medium)
                    color: mix(hygge_stone, hygge_linen, page_mix)
                }

                group {
                    show: page_mix < 0.5
                    opacity: clamp(1.0 - page_mix * 2.0, 0, 1)

                    box {
                        at: card_cx, card_top + 146
                        size: card_w - 32, 92
                        corner: 18
                        color: hygge_card
                        opacity: 0.78
                    }

                    text "System output" {
                        at: card_left + 28, card_top + 122
                        anchor: left center
                        family: "SF Pro"
                        size: 12
                        weight: weight_semibold
                        color: hygge_linen
                    }

                    text vol_text {
                        at: card_cx + card_w / 2 - 28, card_top + 122
                        anchor: right center
                        family: "SF Mono"
                        size: 11
                        weight: weight_semibold
                        color: if(vol_muted, hygge_terracotta, hygge_honey)
                    }

                    AudioMuteBtn(card_left + 44, card_top + 160, vol_muted, toggle_mute_evt)
                    AudioSlider(card_cx + 30, card_top + 160, card_w - 116, 8, vol, vol_muted, set_vol_evt)

                    box {
                        at: card_cx, card_top + 252
                        size: card_w - 32, 92
                        corner: 18
                        color: hygge_card
                        opacity: 0.70
                    }

                    text "System microphone" {
                        at: card_left + 28, card_top + 228
                        anchor: left center
                        family: "SF Pro"
                        size: 12
                        weight: weight_semibold
                        color: hygge_linen
                    }

                    text mic_text {
                        at: card_cx + card_w / 2 - 28, card_top + 228
                        anchor: right center
                        family: "SF Mono"
                        size: 11
                        weight: weight_semibold
                        color: if(mic_muted, hygge_terracotta, hygge_honey)
                    }

                    AudioMuteBtn(card_left + 44, card_top + 266, mic_muted, toggle_mic_mute_evt)
                    AudioSlider(card_cx + 30, card_top + 266, card_w - 116, 8, mic_vol, mic_muted, set_mic_evt)

                    text "Application mixer" {
                        at: card_left + 20, card_top + 302
                        anchor: left center
                        family: "SF Pro"
                        size: 13
                        weight: weight_semibold
                        color: hygge_linen
                    }

                    text "Volume and mute per active stream" {
                        at: card_cx + card_w / 2 - 20, card_top + 302
                        anchor: right center
                        family: "SF Pro"
                        size: 9
                        weight: weight_medium
                        color: hygge_stone
                    }
                }

                group {
                    show: page_mix >= 0.5
                    opacity: clamp(page_mix * 2.0 - 1.0, 0, 1)

                    text "Output devices" {
                        at: card_left + 20, card_top + 114
                        anchor: left center
                        family: "SF Pro"
                        size: 13
                        weight: weight_semibold
                        color: hygge_linen
                    }

                    text "Choose the system destination" {
                        at: card_cx + card_w / 2 - 20, card_top + 114
                        anchor: right center
                        family: "SF Pro"
                        size: 9
                        weight: weight_medium
                        color: hygge_stone
                    }

                    text "Input devices" {
                        at: card_left + 20, card_top + 396
                        anchor: left center
                        family: "SF Pro"
                        size: 13
                        weight: weight_semibold
                        color: hygge_linen
                    }

                    text "Choose the system microphone" {
                        at: card_cx + card_w / 2 - 20, card_top + 396
                        anchor: right center
                        family: "SF Pro"
                        size: 9
                        weight: weight_medium
                        color: hygge_stone
                    }
                }

                children

                text engine_status {
                    at: card_cx, card_top + card_h - 18
                    anchor: center
                    family: "SF Pro"
                    size: text_size_badge
                    weight: weight_medium
                    color: hygge_stone
                }
            }
        }
    }
}
