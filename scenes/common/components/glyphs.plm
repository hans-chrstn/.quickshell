import "../Theme.plm"

library GlyphsLib {
    component Glyph(kind: number, cx: number, cy: number, col: color = theme_ink) {
        group {
            show: kind == 9
            box { at: cx - 2, cy - 2; size: 17, 13; corner: 3; stroke: 1.5; color: col }
            box { at: cx + 3, cy + 3; size: 17, 13; corner: 3; stroke: 1.5; color: col }
        }
        group {
            show: kind == 10
            line { from: cx - 2, cy - 5; to: cx + 3, cy; width: 1.8; color: col }
            line { from: cx + 3, cy; to: cx - 2, cy + 5; width: 1.8; color: col }
        }
        group {
            show: kind == 5

            box {
                at: cx, cy + 1
                size: 19, 13
                corner: 3
                stroke: 1.6
                color: col
            }
            box {
                at: cx - 4, cy - 7
                size: 7, 3
                corner: 1
                color: col
            }
            ellipse {
                at: cx, cy + 1
                radius: 3.1
                stroke: 1.5
                color: col
            }
        }

        group {
            show: kind == 6
            ellipse {
                at: cx, cy
                radius: 7
                stroke: 1.5
                color: col
            }
            ellipse {
                at: cx, cy
                radius: 3.5
                color: col
            }
        }

        group {
            show: kind == 0

            box {
                at: cx - 5, cy
                size: 2.4, 8
                corner: 1.2
                color: col
            }
            box {
                at: cx, cy
                size: 2.4, 14
                corner: 1.2
                color: col
            }
            box {
                at: cx + 5, cy
                size: 2.4, 10
                corner: 1.2
                color: col
            }
        }

        group {
            show: kind == 1

            box {
                at: cx - 5, cy
                size: 4, 8
                corner: 1
                color: col
            }
            path {
                at: cx, cy
                color: col
                move -3, -4
                line 4, -7
                line 4, 7
                line -3, 4
                close
            }
            arc {
                at: cx + 1, cy
                radius: 4.5
                span: 120deg
                rotate: -90deg
                width: 1.5
                color: col
                opacity: 0.5
            }
            arc {
                at: cx + 3, cy
                radius: 7.5
                span: 110deg
                rotate: -90deg
                width: 1.5
                color: col
                opacity: 0.3
            }
        }

        group {
            show: kind == 2

            box {
                at: cx, cy
                size: 18, 14
                corner: 3
                stroke: 1.5
                color: col
            }
            path {
                at: cx, cy + 0.5
                color: col
                move -5, 3.5
                line 3, -4
                line 1.5, 2
                line 2.5, -3
                line 3, 5
                close
            }
            ellipse {
                at: cx + 2.5, cy - 2.5
                radius: 1.3
                color: col
            }
        }

        group {
            show: kind == 3

            box {
                at: cx, cy - 1.5
                size: 5, 9
                corner: 2.5
                color: col
            }
            box {
                at: cx, cy + 4
                size: 1.6, 3
                corner: 0.8
                color: col
            }
            box {
                at: cx, cy + 6.2
                size: 5.5, 1.6
                corner: 0.8
                color: col
            }
        }

        group {
            show: kind == 4

            line {
                from: cx - 4, cy + 2
                to: cx, cy - 2
                width: 1.8
                color: col
            }
            line {
                from: cx, cy - 2
                to: cx + 4, cy + 2
                width: 1.8
                color: col
            }
        }
    }

    component WeatherGlyph(kind: number, cx: number, cy: number, col: color = theme_ink_soft) {
        group {
            show: kind == 1

            box {
                at: cx, cy
                size: 9, 9
                corner: 4.5
                color: col
            }
            box {
                at: cx, cy - 7.6
                size: 1.7, 3.4
                corner: 0.8
                color: col
            }
            box {
                at: cx, cy + 7.6
                size: 1.7, 3.4
                corner: 0.8
                color: col
            }
            box {
                at: cx - 7.6, cy
                size: 3.4, 1.7
                corner: 0.8
                color: col
            }
            box {
                at: cx + 7.6, cy
                size: 3.4, 1.7
                corner: 0.8
                color: col
            }
            box {
                at: cx - 5.3, cy - 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx + 5.3, cy - 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx - 5.3, cy + 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
            box {
                at: cx + 5.3, cy + 5.3
                size: 2.5, 2.5
                corner: 1.3
                color: col
            }
        }

        group {
            show: kind == 2

            box {
                at: cx - 3.9, cy - 3.6
                size: 6.2, 6.2
                corner: 3.1
                color: col
            }
            box {
                at: cx - 3.9, cy - 9.5
                size: 1.5, 2.8
                corner: 0.8
                color: col
            }
            box {
                at: cx - 10.1, cy - 3.6
                size: 2.8, 1.5
                corner: 0.8
                color: col
            }
            box {
                at: cx - 8.1, cy - 8.1
                size: 2.1, 2.1
                corner: 1
                color: col
            }
            ellipse {
                at: cx - 1.7, cy + 1.7
                radius: 3.4
                color: col
            }
            ellipse {
                at: cx + 1.7, cy
                radius: 4.2
                color: col
            }
            ellipse {
                at: cx + 5, cy + 1.7
                radius: 3.1
                color: col
            }
            box {
                at: cx + 1.7, cy + 3.4
                size: 14, 3.9
                corner: 2
                color: col
            }
        }

        group {
            show: kind == 3

            ellipse {
                at: cx - 3.4, cy
                radius: 3.9
                color: col
            }
            ellipse {
                at: cx + 0.3, cy - 2
                radius: 4.8
                color: col
            }
            ellipse {
                at: cx + 4.5, cy
                radius: 3.6
                color: col
            }
            box {
                at: cx + 0.3, cy + 3.1
                size: 15.4, 4.5
                corner: 2.2
                color: col
            }
        }

        group {
            show: kind == 4

            box {
                at: cx, cy - 4.2
                size: 15.4, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx - 0.8, cy - 0.6
                size: 11.2, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx + 0.8, cy + 3.1
                size: 14, 2.2
                corner: 1.1
                color: col
            }
            box {
                at: cx - 0.6, cy + 6.7
                size: 8.4, 2.2
                corner: 1.1
                color: col
            }
        }

        group {
            show: kind == 5

            ellipse {
                at: cx - 2.5, cy - 2
                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
                size: 11.9, 3.6
                corner: 1.8
                color: col
            }
            ellipse {
                at: cx - 4.2, cy + 5
                radius: 1.3
                color: col
            }
            ellipse {
                at: cx, cy + 6.4
                radius: 1.3
                color: col
            }
            ellipse {
                at: cx + 4.2, cy + 5
                radius: 1.3
                color: col
            }
        }

        group {
            show: kind == 6

            ellipse {
                at: cx - 2.5, cy - 2
                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
                size: 11.9, 3.6
                corner: 1.8
                color: col
            }
            box {
                at: cx - 4.5, cy + 4.5
                size: 1.7, 4.2
                corner: 0.8
                color: col
            }
            box {
                at: cx, cy + 6.2
                size: 1.7, 4.2
                corner: 0.8
                color: col
            }
            box {
                at: cx + 4.5, cy + 4.5
                size: 1.7, 4.2
                corner: 0.8
                color: col
            }
        }

        group {
            show: kind == 7

            ellipse {
                at: cx - 2.5, cy - 2
                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
                size: 11.9, 3.6
                corner: 1.8
                color: col
            }
            ellipse {
                at: cx - 4.5, cy + 5
                radius: 1.5
                color: col
            }
            ellipse {
                at: cx, cy + 6.7
                radius: 1.5
                color: col
            }
            ellipse {
                at: cx + 4.5, cy + 5
                radius: 1.5
                color: col
            }
        }

        group {
            show: kind == 8

            ellipse {
                at: cx - 2.5, cy - 2
                radius: 2.8
                color: col
            }
            ellipse {
                at: cx + 0.6, cy - 3.6
                radius: 3.5
                color: col
            }
            ellipse {
                at: cx + 3.6, cy - 2
                radius: 2.7
                color: col
            }
            box {
                at: cx + 0.3, cy - 0.3
                size: 11.9, 3.6
                corner: 1.8
                color: col
            }
            box {
                at: cx - 0.8, cy + 3.9
                size: 2.5, 2.8
                corner: 0.7
                color: col
            }
            box {
                at: cx + 1.3, cy + 6.4
                size: 2.5, 2.8
                corner: 0.7
                color: col
            }
            box {
                at: cx - 0.3, cy + 8.7
                size: 2.5, 2.2
                corner: 0.7
                color: col
            }
        }
    }

}
