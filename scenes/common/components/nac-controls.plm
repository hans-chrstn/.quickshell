import "../Theme.plm"
import "glyphs.plm"

library NacControlsLib {
    component NacIcon(cx: number, cy: number, r: number, glyph_kind: number, is_active: bool) {
        box {
            at: cx, cy
            size: r * 2, r * 2
            corner: r
            color: nacre_ink
            opacity: if(is_active, 0.16, 0.08)
        }
        box {
            at: cx, cy
            size: r * 2, r * 2
            corner: r
            stroke: 1
            color: nacre_ink
            opacity: 0.14
        }
        NacGlyph(glyph_kind, cx, cy, if(is_active, nacre_accent, nacre_ink_soft))
    }

    component NacIconBtn(
        cx: number,
        cy: number,
        r: number,
        glyph_kind: number,
        btn_label: text,
        is_active: bool,
        btn_evt: event
    ) {
        box {
            at: cx, cy
            size: r * 2, r * 2
            corner: r
            color: nacre_ink
            opacity: if(is_active, 0.16, 0.08)
        }
        box {
            at: cx, cy
            size: r * 2, r * 2
            corner: r
            stroke: 1
            color: nacre_ink
            opacity: 0.14
        }
        NacGlyph(glyph_kind, cx, cy, if(is_active, nacre_accent, nacre_ink_soft))

        zone box nicon_hit {
            at: cx, cy
            size: r * 2, r * 2
            corner: r
            cursor: pointer
            role: button
            label: btn_label
        }

        on press nicon_hit { emit btn_evt }
    }

    component NacSlider(cx: number, cy: number, w: number, h: number, val: number, muted: bool, seek_evt: event) {
        prop val_s = 0 ~calm
        prop mut_s = 0 ~calm
        follow val_s = val
        follow mut_s = if(muted, 1, 0)
        let frac = clamp(val_s / 100, 0, 1)
        let fill_w = max(w * frac, h)

        box {
            at: cx, cy
            size: w, h
            corner: h / 2
            color: nacre_ink
            opacity: 0.12
        }
        box {
            from: cx - w / 2, cy - h / 2
            size: fill_w, h
            corner: h / 2
            color: mix(nacre_accent, nacre_warm, mut_s)
            opacity: 1 - 0.45 * mut_s
        }
        ellipse {
            at: cx - w / 2 + w * frac, cy
            radius: h * 0.85
            color: mix(nacre_ink, nacre_ink_soft, mut_s)
        }

        zone box nslider_hit {
            at: cx, cy
            size: w, h + 16
            cursor: pointer
            role: slider
            label: "Adjust Audio Level"
        }

        on press nslider_hit { emit seek_evt(clamp((pointer.x - (cx - w / 2)) / w * 100, 0, 100)) }
        on drag nslider_hit { emit seek_evt(clamp((pointer.x - (cx - w / 2)) / w * 100, 0, 100)) }
    }

    component NacMuteBtn(cx: number, cy: number, is_muted: bool, mute_evt: event) {
        prop mut_s = 0 ~lively
        follow mut_s = if(is_muted, 1, 0)

        box {
            at: cx, cy
            size: 32, 32
            corner: 16
            color: mix(nacre_ink, nacre_warm, mut_s)
            opacity: 0.08 + 0.14 * mut_s
        }
        box {
            at: cx - 5, cy
            size: 4, 8
            corner: 1
            color: mix(nacre_ink, nacre_warm, mut_s)
        }
        path {
            at: cx, cy
            color: mix(nacre_ink, nacre_warm, mut_s)
            move -3, -4
            line 4, -7
            line 4, 7
            line -3, 4
            close
        }
        group {
            show: mut_s < 0.5
            opacity: 1 - mut_s
            arc {
                at: cx + 1, cy
                radius: 4.5
                span: 120deg
                rotate: -90deg
                width: 1.5
                color: nacre_accent
            }
        }
        group {
            show: mut_s > 0.5
            opacity: mut_s
            line {
                from: cx - 7, cy - 7
                to: cx + 7, cy + 7
                width: 1.8
                color: nacre_warm
            }
        }

        zone box nmute_hit {
            at: cx, cy
            size: 32, 32
            cursor: pointer
            role: button
            label: "Toggle Audio Mute"
        }

        on press nmute_hit { emit mute_evt }
    }

    component NacMicBtn(cx: number, cy: number, is_muted: bool, mute_evt: event) {
        prop mut_s = 0 ~lively
        follow mut_s = if(is_muted, 1, 0)

        box {
            at: cx, cy
            size: 32, 32
            corner: 16
            color: mix(nacre_ink, nacre_warm, mut_s)
            opacity: 0.08 + 0.14 * mut_s
        }
        NacGlyph(3, cx, cy, mix(nacre_ink, nacre_warm, mut_s))

        group {
            show: mut_s > 0.5
            opacity: mut_s
            line {
                from: cx - 7, cy - 7
                to: cx + 7, cy + 7
                width: 1.8
                color: nacre_warm
            }
        }

        zone box nmic_hit {
            at: cx, cy
            size: 32, 32
            cursor: pointer
            role: button
            label: "Toggle Microphone Mute"
        }

        on press nmic_hit { emit mute_evt }
    }

    component NacTab(x: number, y: number, w: number, tab_label: text, is_on: bool, tab_evt: event) {
        prop on_s = 0 ~lively
        follow on_s = if(is_on, 1, 0)

        box {
            at: x, y
            size: w, 28
            corner: 14
            color: nacre_ink
            opacity: 0.03 + 0.08 * on_s + 0.04 * (1 - on_s) * ntab_hit.hover
        }
        text tab_label {
            at: x, y
            anchor: center
            family: "SF Pro"
            size: nacre_fs10
            weight: nacre_w700
            color: mix(nacre_ink_faint, nacre_ink, on_s)
        }
        box {
            at: x, y + 10
            size: max(24 * on_s, 0.01), 2
            corner: 1
            color: nacre_accent
            opacity: on_s
        }

        zone box ntab_hit {
            at: x, y
            size: w, 28
            corner: 14
            cursor: pointer
            role: button
            label: tab_label
        }

        on press ntab_hit { emit tab_evt }
    }

    component NacChip(dev: record, w: number, is_active: bool, sel_evt: event, is_input: bool = false) {
        size: w, 48

        prop act_s = 0 ~lively
        follow act_s = if(is_active, 1, 0)

        zone box nchip_hit {
            from: 0, 0
            size: w, 48
            corner: 12
            cursor: pointer
            role: button
            label: dev.name
        }

        box {
            from: 0, 0
            size: w, 48
            corner: 12
            color: nacre_accent
            opacity: (0.04 + 0.08 * act_s) * (1 - 0.6 * nchip_hit.pressed) + 0.05 * nchip_hit.hover
        }
        box {
            from: 0, 0
            size: w, 48
            corner: 12
            stroke: 1
            color: mix(nacre_ink, nacre_accent, act_s)
            opacity: 0.12 + 0.28 * act_s
        }
        NacGlyph(if(is_input, 3, 1), 24, 24, mix(nacre_ink_soft, nacre_accent, act_s))
        text dev.name {
            at: 42, 24
            anchor: left center
            family: "SF Pro"
            size: nacre_fs12
            weight: nacre_w500
            color: mix(nacre_ink_soft, nacre_ink, act_s)
            width: w - 96
            lines: 1
        }
        group {
            show: act_s > 0.5
            opacity: act_s
            box {
                at: w - 16, 24
                size: 6, 6
                corner: 3
                color: nacre_accent
            }
        }

        on press nchip_hit { emit sel_evt(dev.id) }
    }

    component NacMeter(cx: number, cy: number, w: number, h: number, lvl: number, on: color = nacre_accent) {
        prop lvl_s = 0 ~slow
        follow lvl_s = lvl
        let bw = (w - 15 * 3) / 16
        repeat i in 0..15 {
            let t = clamp(lvl_s * 16 - i, 0, 1)
            box {
                at: cx - w / 2 + bw / 2 + i * (bw + 3), cy
                size: bw, h
                corner: bw / 2
                color: mix(nacre_ink, on, t)
                opacity: 0.16 + 0.84 * t
            }
        }
    }

    component NacMixRow(m: record, vol_evt: event, mute_evt: event, route_evt: event) {
        size: 408, 56
        let is_play = m.kind == 0
        let dev_col = if(m.routed, nacre_accent, nacre_ink_soft)

        box {
            from: 0, 0
            size: 408, 56
            corner: 14
            color: nacre_ink
            opacity: 0.05 + 0.05 * max(max(mixrow_vol.hover, mixrow_mute.hover), mixrow_route.hover)
        }
        NacGlyph(if(is_play, 1, 3), 20, 28, if(is_play, nacre_ink_soft, nacre_warm))

        text m.name {
            at: 42, 20
            anchor: left center
            family: "SF Pro"
            size: nacre_fs12
            weight: nacre_w600
            color: nacre_ink
            width: 150
            lines: 1
        }
        group {
            show: is_play
            text m.title {
                at: 42, 44
                anchor: left center
                family: "SF Pro"
                size: nacre_fs9
                weight: nacre_w400
                color: nacre_ink_faint
                width: 150
                lines: 1
            }
        }
        group {
            show: is_play
            NacSlider(258, 20, 96, 5, m.volume, m.muted, vol_evt)
            NacMuteBtn(386, 20, m.muted, mute_evt)
        }

        group {
            show: m.routed
            box {
                at: 190, if(is_play, 44, 28)
                size: 6, 6
                corner: 3
                color: dev_col
            }
        }

        text m.device {
            at: 270, if(is_play, 44, 28)
            anchor: center
            family: "SF Mono"
            size: nacre_fs9
            weight: nacre_w500
            color: dev_col
            width: 130
            lines: 1
        }

        zone box mixrow_vol {
            at: 258, 20
            size: 96, 21
            active: is_play
            cursor: pointer
            role: slider
            label: "Adjust application volume"
        }

        zone box mixrow_mute {
            at: 386, 20
            size: 32, 32
            active: is_play
            cursor: pointer
            role: button
            label: "Mute application"
        }

        zone box mixrow_route {
            at: 270, if(is_play, 44, 28)
            size: 150, 20
            cursor: pointer
            role: button
            label: "Route to another device"
        }

        on press mixrow_vol { emit vol_evt(m.id * 1000 + clamp((local.x - 210) / 96 * 100, 0, 100)) }
        on drag mixrow_vol { emit vol_evt(m.id * 1000 + clamp((local.x - 210) / 96 * 100, 0, 100)) }
        on press mixrow_mute { emit mute_evt(m.id) }
        on press mixrow_route { emit route_evt(if(is_play, m.id, -m.id - 1)) }
    }

    component NacFileRow(it_id: number, it_name: text, it_is_dir: bool, w: number, pick_evt: event) {
        size: w, 40

        box {
            from: 0, 0
            size: w, 40
            corner: 10
            color: nacre_ink
            opacity: 0.05
        }

        group {
            show: it_is_dir
            move: 18, 20
            path {
                color: nacre_warm
                move -6, -4
                line -2, -4
                line 0, -2
                line 6, -2
                line 6, 4
                line -6, 4
                close
            }
        }

        group {
            show: not it_is_dir
            move: 18, 20
            box {
                at: 0, 0
                size: 10, 12
                corner: 1.5
                color: nacre_ink_soft
                opacity: 0.8
            }
        }

        text it_name {
            at: 36, 20
            anchor: left center
            family: "SF Pro"
            size: nacre_fs13
            weight: nacre_w500
            color: if(it_is_dir, nacre_warm, nacre_ink_soft)
            width: w - 52
            lines: 1
        }

        zone box nrow_hit {
            from: 0, 0
            size: w, 40
            corner: 10
            cursor: pointer
            role: button
            label: it_name
        }

        on press nrow_hit { emit pick_evt(it_id) }
    }

}
