import "../Theme.plm"

library GlassLib {
    component GlassCard(
        cx: number,
        cy: number,
        w: number,
        h: number,
        corner: number,
        shadow: number = 0.30,
        lens_enabled: bool = true,
        shade: number = 0
    ) {
        body {
            color: theme_glass_base
            glass: theme_glass_amount
            lens: lens_enabled
            frost: auto
            smoke: theme_glass_smoke
            tint: theme_glass_tint
            refraction: theme_glass_refraction
            dispersion: theme_glass_dispersion
            mirror: theme_glass_mirror
            highlight: theme_glass_highlight
            rim: theme_glass_rim
            shadow: 0, 8, 24, shadow

            box {
                at: cx, cy
                size: w, h
                corner: corner
            }
        }
        box {
            at: cx, cy
            size: w, h
            corner: corner
            color: theme_glass_base
            opacity: shade
        }
    }

}
