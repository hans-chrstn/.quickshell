// CompactView.plm — Apple-inspired compact Dynamic Island view
// Left: Glowing status badge + live time; Right: Date + 5 living audio equalizer bars.
import "Theme.plm"

library CompactViewLib {
    component CompactView(
        cx: number,
        cy: number,
        time_str: text,
        date_str: text,
        w1: number,
        w2: number,
        w3: number,
        w4: number,
        opacity_val: number,
        ink: color = ink_primary,
        accent: color = accent_primary
    ) {
        group {
            opacity: opacity_val

            // Left icon badge: dark squircle container
            box {
                at: cx - 88, cy
                size: compact_badge_size, compact_badge_size
                corner: compact_badge_corner
                color: badge_bg
            }

            // Glowing indicator jewel in center of badge
            ellipse {
                at: cx - 88, cy
                radius: compact_jewel_outer_r
                color: accent
            }
            ellipse {
                at: cx - 88, cy
                radius: compact_jewel_inner_r
                color: #ffffff
            }

            // Compact Time
            text time_str {
                at: cx - 72, cy
                anchor: left center
                family: "SF Compact"
                size: text_size_body
                weight: weight_semibold
                color: ink
            }

            // Compact Date
            text date_str {
                at: cx + 38, cy
                anchor: right center
                family: "SF Compact"
                size: text_size_caption
                weight: weight_medium
                color: ink_secondary
            }

            // Living mini equalizer visualizer (5 bars)
            box {
                at: cx + 56, cy
                size: compact_eq_bar_w, 7 + w1
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 64, cy
                size: compact_eq_bar_w, 12 + w2
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 72, cy
                size: compact_eq_bar_w, 16 + w3
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 80, cy
                size: compact_eq_bar_w, 11 + w4
                corner: compact_eq_bar_corner
                color: accent
            }
            box {
                at: cx + 88, cy
                size: compact_eq_bar_w, 8 + w1
                corner: compact_eq_bar_corner
                color: accent
            }
        }
    }
}
