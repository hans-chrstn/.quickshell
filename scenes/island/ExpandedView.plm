// ExpandedView.plm — Apple-inspired expanded Dynamic Island card
// Rich media/status card: Header with visualizer, Artwork + Track info, Scrub bar, Playback controls.
import "Theme.plm"

library ExpandedViewLib {
    component ExpandedView(
        cx: number,
        cy: number,
        title_str: text,
        artist_str: text,
        time_elapsed: text,
        time_remaining: text,
        progress_val: number,
        w1: number,
        w2: number,
        w3: number,
        w4: number,
        opacity_val: number,
        is_playing: bool = false,
        ink_pri: color = ink_primary,
        ink_sec: color = ink_secondary,
        ink_mut: color = ink_muted,
        accent: color = accent_primary
    ) {
        group {
            opacity: opacity_val

            // ── 1. Top Header Row ─────────────────────────────────────────
            // Context header label
            text if(is_playing, "NOW PLAYING", "DESKTOP AUDIO") {
                at: cx - 142, cy - 48
                anchor: left center
                family: "SF Pro"
                size: text_size_badge
                weight: weight_bold
                color: ink_mut
            }

            // Glowing status bead
            ellipse {
                at: cx - 64, cy - 48
                radius: 2.5
                color: accent
            }

            // Top right mini visualizer bars (5 bars)
            box {
                at: cx + 118, cy - 48
                size: 2, 5 + w1 * 0.7
                corner: 1
                color: accent
            }
            box {
                at: cx + 124, cy - 48
                size: 2, 8 + w2 * 0.7
                corner: 1
                color: accent
            }
            box {
                at: cx + 130, cy - 48
                size: 2, 11 + w3 * 0.7
                corner: 1
                color: accent
            }
            box {
                at: cx + 136, cy - 48
                size: 2, 7 + w4 * 0.7
                corner: 1
                color: accent
            }
            box {
                at: cx + 142, cy - 48
                size: 2, 9 + w1 * 0.7
                corner: 1
                color: accent
            }

            // ── 2. Artwork & Track Info Row ──────────────────────────────
            // Artwork container (squircle vinyl disc)
            box {
                at: cx - 124, cy - 14
                size: artwork_box_size, artwork_box_size
                corner: artwork_box_corner
                color: badge_bg
            }
            // Artwork inner rim/accent
            ellipse {
                at: cx - 124, cy - 14
                radius: 11
                color: track_bg
            }
            ellipse {
                at: cx - 124, cy - 14
                radius: 5
                color: accent
            }
            ellipse {
                at: cx - 124, cy - 14
                radius: 2
                color: #ffffff
            }

            // Track Title
            text title_str {
                at: cx - 94, cy - 20
                anchor: left center
                family: "SF Pro"
                size: text_size_title
                weight: weight_semibold
                width: title_max_width
                lines: 1
                color: ink_pri
            }

            // Artist / Subtitle
            text artist_str {
                at: cx - 94, cy - 6
                anchor: left center
                family: "SF Pro"
                size: text_size_caption
                weight: weight_medium
                width: title_max_width
                lines: 1
                color: ink_sec
            }

            // ── 3. Audio Progress / Scrubber Row ─────────────────────────
            // Background track
            box {
                at: cx, cy + 16
                size: scrubber_track_w, scrubber_track_h
                corner: scrubber_track_corner
                color: track_bg
            }
            // Active progress fill (proportional to playback progress)
            let fill_w = clamp(progress_val * scrubber_track_w, 0, scrubber_track_w)
            box {
                at: cx - 142 + fill_w / 2, cy + 16
                size: fill_w, scrubber_track_h
                corner: scrubber_track_corner
                color: accent
            }
            // Playhead indicator knob
            ellipse {
                at: cx - 142 + fill_w, cy + 16
                radius: scrubber_knob_r
                color: #ffffff
                show: fill_w > 0
            }

            // Timestamps
            text time_elapsed {
                at: cx - 142, cy + 28
                anchor: left center
                family: "SF Mono"
                size: text_size_badge
                weight: weight_medium
                color: ink_mut
            }
            text time_remaining {
                at: cx + 142, cy + 28
                anchor: right center
                family: "SF Mono"
                size: text_size_badge
                weight: weight_medium
                color: ink_mut
            }

            // ── 4. Transport Controls Row ────────────────────────────────
            // Previous track button (crisp geometric dual chevrons)
            path {
                at: cx - 49, cy + 46
                color: ink_sec
                move 3, -5
                line -3, 0
                line 3, 5
                close
            }
            path {
                at: cx - 55, cy + 46
                color: ink_sec
                move 3, -5
                line -3, 0
                line 3, 5
                close
            }

            // Center Action / Play-Pause circular button
            ellipse {
                at: cx, cy + 46
                radius: play_button_r
                color: ink_pri
            }
            // Pause bars inside the button (when playing)
            box {
                at: cx - 3.5, cy + 46
                size: 3, 10
                corner: 1.5
                color: glass_base_color
                opacity: if(is_playing, 1, 0)
            }
            box {
                at: cx + 3.5, cy + 46
                size: 3, 10
                corner: 1.5
                color: glass_base_color
                opacity: if(is_playing, 1, 0)
            }
            // Play triangle inside the button (when paused)
            path {
                at: cx + 1, cy + 46
                color: glass_base_color
                opacity: if(is_playing, 0, 1)
                move -3, -5
                line 4, 0
                line -3, 5
                close
            }

            // Next track button (crisp geometric dual chevrons)
            path {
                at: cx + 49, cy + 46
                color: ink_sec
                move -3, -5
                line 3, 0
                line -3, 5
                close
            }
            path {
                at: cx + 55, cy + 46
                color: ink_sec
                move -3, -5
                line 3, 0
                line -3, 5
                close
            }
        }
    }
}
