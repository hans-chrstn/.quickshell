language 0.4
import "IslandFace.plm" as face
import "IslandClock.plm" as clock
library IslandBody strict {
    component Body(viewportWidth: number, clockTime: text, clockDate: text, debugMode: bool = false) {
        size: viewportWidth, 144
        let cx = viewportWidth / 2
        fact phase: dormant | compact | wide = dormant
        fact mood: neutral | curious | pleased = neutral
        prop presence = 0
        prop growth = 0
        prop roundness = 0
        prop eyes = 0
        prop mouth = 0
        prop expanded = 0
        prop faceHandoff = 0
        prop timeReveal = 0
        prop dateReveal = 0
        layer bodyMorph {
            open while phase == wide { expanded: 1 ~gentle }
            closed { expanded: 0 ~700ms }
        }
        layer faceMorph {
            clock while phase == wide { faceHandoff: 1 ~700ms after 80ms }
            face { faceHandoff: 0 ~550ms after 80ms }
        }
        layer reveal {
            shown while phase != dormant {
                presence: 1 ~350ms
                growth: 1 ~220ms after 240ms
                roundness: 1 ~150ms after 410ms
                eyes: 1 ~170ms after 540ms
                mouth: 1 ~130ms after 690ms
            }
            hidden {
                mouth: 0 ~80ms
                eyes: 0 ~100ms
                roundness: 0 ~140ms after 70ms
                growth: 0 ~170ms after 140ms
                presence: 0 ~240ms after 210ms
            }
        }
        layer clockHandoff {
            open while phase == wide {
                timeReveal: 1 ~230ms after 450ms
                dateReveal: 1 ~260ms after 600ms
            }
            closed {
                dateReveal: 0 ~130ms
                timeReveal: 0 ~180ms
            }
        }
        let width = 46 + presence * 2 + expanded * 238
        let height = 46 + presence * 2 + expanded * 24
        let top = 14
        let rise = (1 - presence) * (height + top + 12)
        let centerY = top + height / 2 - rise
        let faceY = centerY - 1
        let hitHeight = if(phase == dormant, 12, top + height)
        let dropletTip = 12 * (1 - roundness) * (1 - expanded)
        let radius = (10 + growth * 14) * (1 - expanded)

        body {
            gradient: cx, 8 to cx, 94, #111214, #050506
            rim: 5%
            shadow: 0, 7, 10, 22%
            path {
                at: cx, centerY
                show: expanded < 0.98
                move 0, -radius - dropletTip
                curve -radius, 0 via -radius, -radius
                curve 0, radius via -radius, radius
                curve radius, 0 via radius, radius
                curve 0, -radius - dropletTip via radius, -radius
                close
            }
            box { at: cx, centerY; size: width * expanded, height * expanded; corner: 24 + expanded * 11; blend: expanded * 18 }
        }

        face.Face(viewportWidth, cx, faceY, cx - 36, eyes, mouth, faceHandoff, mood == curious, mood == pleased)
        clock.ClockContent(viewportWidth, centerY, clockTime, clockDate, expanded, timeReveal, dateReveal)

        zone box island_hit {
            at: cx, hitHeight / 2
            size: max(96, width), hitHeight
            corner: 36
            cursor: pointer
            label: "Toggle Nacre island"
        }

        box { at: cx - 82, 106; size: 74, 28; corner: 14; color: if(mood == neutral, #d9ae79, #292a2d); show: debugMode }
        text "Neutral" { at: cx - 82, 106; anchor: center; size: 11; color: if(mood == neutral, #161719, #eeeae4); show: debugMode }
        zone box neutral_button { at: cx - 82, 106; size: 74, 28; corner: 14; cursor: pointer; label: "Show neutral face"; show: debugMode }
        box { at: cx, 106; size: 74, 28; corner: 14; color: if(mood == curious, #d9ae79, #292a2d); show: debugMode }
        text "Curious" { at: cx, 106; anchor: center; size: 11; color: if(mood == curious, #161719, #eeeae4); show: debugMode }
        zone box curious_button { at: cx, 106; size: 74, 28; corner: 14; cursor: pointer; label: "Show curious face"; show: debugMode }
        box { at: cx + 82, 106; size: 74, 28; corner: 14; color: if(mood == pleased, #d9ae79, #292a2d); show: debugMode }
        text "Pleased" { at: cx + 82, 106; anchor: center; size: 11; color: if(mood == pleased, #161719, #eeeae4); show: debugMode }
        zone box pleased_button { at: cx + 82, 106; size: 74, 28; corner: 14; cursor: pointer; label: "Show pleased face"; show: debugMode }

        on enter island_hit while phase == dormant { phase = compact; mood = curious }
        on leave island_hit while not debugMode { phase = dormant; mood = neutral }
        on press island_hit while not debugMode { phase = if(phase == wide, compact, wide); mood = pleased }
        on key escape while phase == wide { phase = compact; mood = curious }
        on press neutral_button { phase = compact; mood = neutral }
        on press curious_button { phase = compact; mood = curious }
        on press pleased_button { phase = compact; mood = pleased }
    }
}
