language 0.4
library IslandClock strict {
    component ClockContent(viewportWidth: number, centerY: number, clockTime: text, clockDate: text, expanded: number, timeReveal: number, dateReveal: number) {
        size: viewportWidth, 144
        let cx = viewportWidth / 2
        let timeOpacity = timeReveal * clamp((expanded - 0.62) * 3.5, 0, 1)
        let dateOpacity = dateReveal * clamp((expanded - 0.82) * 5.6, 0, 1)

        text clockTime {
            at: cx - 76 - 18 * (1 - timeReveal), centerY - 1
            anchor: left center
            size: 29
            weight: 600
            family: "sans-serif"
            color: #f4f2ef
            opacity: timeOpacity
            letter_opacity: if(letter == 2, 0, 1)
            letter_move: if(letter > 2, 8, 0), 0
        }
        text clockDate {
            at: cx + 26 - 24 * (1 - dateReveal), centerY + 1
            anchor: left center
            size: 12.5
            weight: 600
            family: "sans-serif"
            color: #bab8b5
            opacity: dateOpacity
        }
    }
}
