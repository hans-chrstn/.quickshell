// Theme.plm — Centralized Configuration, Tokens, Theme, and Physics Settings
// Mandatory source of truth for all geometry, springs, glass materials,
// typography scales, shadows, colors, dimensions, and hit zones.
library Theme {
    // ── 1. Color Palette Tokens ───────────────────────────────────────────
